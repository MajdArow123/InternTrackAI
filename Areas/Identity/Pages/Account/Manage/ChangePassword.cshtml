@page
@model InternTrackAI.Areas.Identity.Pages.Account.Manage.ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="container py-4 container-narrow">

    <nav class="breadcrumb-nav" aria-label="breadcrumb">
        <ol class="breadcrumb-list">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li><a asp-page="./Index">Account settings</a></li>
            <li>Change password</li>
        </ol>
    </nav>

    <div class="page-header">
        <div>
            <h2>Change password</h2>
            <p class="sub">Choose a strong password to keep your account secure</p>
        </div>
    </div>

    @if (Model.StatusMessage != null)
    {
        <div class="alert alert-dismissible fade show py-2 mb-3 profile-success-alert" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="form-card">
        @if (Model.IsDemoAccount)
        {
            <p class="form-hint mb-3" data-demo-guard="password">@InternTrackAI.Services.ConfiguredAccounts.DemoUnavailableMessage</p>
        }
        <form method="post">
            @Html.AntiForgeryToken()
            <fieldset disabled="@Model.IsDemoAccount">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Input.OldPassword" class="form-label">Current password</label>
                    <input asp-for="Input.OldPassword" class="form-control" type="password"
                           placeholder="••••••••" autocomplete="current-password" />
                    <span asp-validation-for="Input.OldPassword" class="text-danger field-validation-error"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Input.NewPassword" class="form-label">New password</label>
                    <input asp-for="Input.NewPassword" class="form-control" type="password"
                           placeholder="At least 6 characters" autocomplete="new-password" />
                    <span asp-validation-for="Input.NewPassword" class="text-danger field-validation-error"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirm new password</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" type="password"
                           placeholder="••••••••" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger field-validation-error"></span>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">Update password</button>
                <a asp-page="./Index" class="btn btn-outline-secondary px-4">Cancel</a>
            </div>
            </fieldset>
        </form>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
