@page
@model InternTrackAI.Areas.Identity.Pages.Account.Manage.DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete Account";
}

<div class="container py-4 container-xnarrow">

    <nav class="breadcrumb-nav" aria-label="breadcrumb">
        <ol class="breadcrumb-list">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li><a asp-page="./Index">Account settings</a></li>
            <li>Delete account</li>
        </ol>
    </nav>

    <div class="page-header">
        <div>
            <h2>Delete account</h2>
            <p class="sub">This permanently removes your account and everything in it</p>
        </div>
    </div>

    <div class="app-table-wrapper mb-4">
        <div class="card-header-clean">
            <h5>What gets deleted</h5>
        </div>
        <div class="p-4">
            @* data-purges names the tables each line covers. DeletePersonalDataTests reads them and fails if a
               table UserDataPurger clears is missing here, or if one is listed that the purge leaves behind. *@
            <ul class="mb-0 kv-list ps-3">
                <li>Your login and account settings</li>
                <li data-purges="UserProfiles">Your profile, photo, skills, and target roles</li>
                <li data-purges="JobApplications,ApplicationNotes">Every tracked application and its notes</li>
                <li data-purges="ResumeVersions,ParsedResumes">Uploaded resumes, their extracted text, and any AI analysis of them</li>
                <li data-purges="GeneratedCoverLetters">Generated cover letters</li>
                <li data-purges="PracticeQuestions">Practice and interview prep questions, your answers, and their scores</li>
                <li data-purges="GmailConnections,StatusSuggestions">Your Gmail connection (access is revoked with Google) and the suggestions made from your inbox</li>
            </ul>
        </div>
    </div>

    <div class="form-card danger-confirm-card">
        @if (Model.IsDemoAccount)
        {
            <p class="form-hint mb-3" data-demo-guard="delete">@InternTrackAI.Services.ConfiguredAccounts.DemoUnavailableMessage</p>
        }
        else
        {
            <p class="mb-3 danger-confirm-text">
                Deleting your account cannot be undone. Confirm your password to continue.
            </p>
        }
        <form method="post">
            @Html.AntiForgeryToken()
            <fieldset disabled="@Model.IsDemoAccount">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            @if (Model.RequirePassword)
            {
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Password</label>
                    <input asp-for="Input.Password" class="form-control" type="password"
                           placeholder="••••••••" autocomplete="current-password" />
                    <span asp-validation-for="Input.Password" class="text-danger field-validation-error"></span>
                </div>
            }
            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-danger px-4">Delete my account</button>
                <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
            </fieldset>
        </form>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
