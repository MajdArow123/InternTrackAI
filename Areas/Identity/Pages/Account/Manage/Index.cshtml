@page
@model InternTrackAI.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = "Account Settings";
}

<div class="container py-4 container-narrow">

    <nav class="breadcrumb-nav" aria-label="breadcrumb">
        <ol class="breadcrumb-list">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li><a asp-controller="Profile" asp-action="Index">Profile</a></li>
            <li>Account settings</li>
        </ol>
    </nav>

    <div class="page-header">
        <div>
            <h2>Account settings</h2>
            <p class="sub">Manage your login credentials and display preferences</p>
        </div>
    </div>

    @if (Model.StatusMessage != null)
    {
        <div class="alert alert-dismissible fade show py-2 mb-3 profile-success-alert" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Email -->
    <div class="form-card mb-3">
        <p class="form-section-title">Email address</p>
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <p class="mb-0 fw-medium">@Model.Email</p>
            @if (Model.IsEmailConfirmed)
            {
                <span class="status-badge badge-offer">Verified</span>
            }
            else
            {
                <span class="status-badge badge-interview">Not verified</span>
            }
        </div>
        <p class="form-hint mb-0 mt-2">Email changes require re-registration. Contact support if needed.</p>
    </div>

    <!-- Display Name -->
    <div class="form-card mb-3">
        <p class="form-section-title">Display name</p>
        <p class="form-hint mb-3">Shown in the navbar instead of your email address.</p>
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="row g-3 align-items-end">
                <div class="col-sm-8">
                    <label asp-for="Input.DisplayName" class="form-label">Display name</label>
                    <input asp-for="Input.DisplayName" class="form-control"
                           placeholder="e.g. Alex" maxlength="50" />
                    <span asp-validation-for="Input.DisplayName" class="text-danger field-validation-error"></span>
                </div>
                <div class="col-sm-4">
                    <button type="submit" class="btn btn-primary w-100">Save</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Password -->
    <div class="form-card mb-3">
        <p class="form-section-title">Password</p>
        <p class="form-hint mb-3">Keep your account secure with a strong password.</p>
        <a asp-page="./ChangePassword" class="btn btn-outline-secondary">Change password</a>
    </div>

    <!-- Danger Zone -->
    <div class="form-card mb-3 danger-zone-card">
        <p class="form-section-title text-danger">Danger zone</p>
        <p class="form-hint mb-3">Permanently delete your account and all associated data.</p>
        <a asp-page="./DeletePersonalData" class="btn btn-outline-danger">Delete account</a>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
