    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="17.14.28" PrivateAssets="all" />
    <PackageReference Include="NuGet.Packaging" Version="6.14.3" PrivateAssets="all" />
    <PackageReference Include="NuGet.Protocol" Version="6.14.3" PrivateAssets="all" />
