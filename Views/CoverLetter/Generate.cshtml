@model InternTrackAI.Models.ViewModels.CoverLetterGeneratorViewModel

@{
    ViewData["Title"] = "Cover Letter Generator";
}

<div class="container py-4 container-narrow">

    <nav class="breadcrumb-nav" aria-label="breadcrumb">
        <ol class="breadcrumb-list">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li>Cover Letter</li>
        </ol>
    </nav>

    <div class="page-header">
        <div>
            <h2>Cover letters</h2>
            <p class="sub">AI-generated cover letters personalized to each job</p>
        </div>
        <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary">View profile</a>
    </div>

    @if (!Model.HasActiveResume)
    {
        <div class="cl-info-banner mb-3">
            No active resume found. <a asp-controller="Profile" asp-action="Index" class="cl-info-link">Upload a resume on your Profile page</a> to get fully personalized cover letters. You can still generate without one.
        </div>
    }

    @if (!Model.Applications.Any())
    {
        <div class="cl-info-banner mb-3">
            No job applications yet. <a asp-controller="JobApplications" asp-action="Create" class="cl-info-link">Add an application</a> to use its job description for generation.
        </div>
    }

    <partial name="_GenerateForm" model="Model" />
    <partial name="_Output" model="Model" />
    <partial name="_SavedLetters" model="Model" />

</div>

@section Scripts {
    <script src="~/lib/jspdf/jspdf.umd.min.js"></script>
    <script src="~/js/cover-letter.js" asp-append-version="true"></script>
}
