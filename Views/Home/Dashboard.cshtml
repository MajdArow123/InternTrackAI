@model InternTrackAI.Models.ViewModels.DashboardViewModel
@using InternTrackAI.Models.Enums

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">

    <!-- Breadcrumb -->
    <nav class="breadcrumb-nav" aria-label="breadcrumb">
        <ol class="breadcrumb-list">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li>Dashboard</li>
        </ol>
    </nav>

    <!-- Page header -->
    <div class="page-header">
        <div>
            <h1>Dashboard</h1>
            <p class="sub">Your internship search at a glance</p>
        </div>
        <a asp-controller="JobApplications" asp-action="Create" class="btn btn-primary">
            + Add Application
        </a>
    </div>

    <partial name="_Onboarding" model="Model" />
    <partial name="_InboxSuggestions" model="Model" />
    <partial name="_Alerts" model="Model" />
    <partial name="_StatCards" model="Model" />
    <partial name="_Analytics" model="Model" />
    <partial name="_PracticeStats" model="Model" />
    <partial name="_ResumePerformance" model="Model" />
    <partial name="_RecentApplications" model="Model" />

</div>

@if (Model.TotalApplications > 0)
{
    <partial name="_FollowUpModal" />
}

@section Scripts {
<script type="application/json" id="appsOverTimeData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApplicationsOverTime.Select(kv => new { label = kv.Key, value = kv.Value })))</script>
@if (!Model.SkillGaps.Hide)
{
    var sg = Model.SkillGaps;
    var buckets = new[] { sg.All }.Concat(sg.Roles).Concat(sg.Other is null ? Array.Empty<InternTrackAI.Models.ViewModels.SkillGapBucket>() : new[] { sg.Other });
<script type="application/json" id="skillGapData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { analyzed = sg.AnalyzedApplications, buckets, applications = sg.Applications }, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)))</script>
}
<script src="~/lib/chart.js/chart.umd.min.js"></script>
<script src="~/js/dashboard.js" asp-append-version="true"></script>
<script src="~/js/skill-gap.js" asp-append-version="true"></script>
<script src="~/js/reminders.js" asp-append-version="true"></script>
<script src="~/js/follow-up.js" asp-append-version="true"></script>
<script src="~/js/suggestions.js" asp-append-version="true"></script>
}
