@model InternTrackAI.Models.ViewModels.DashboardViewModel
@using InternTrackAI.Models.Enums

@{
    ViewData["Title"] = "Dashboard";

    string BadgeClass(ApplicationStatus s) => s switch
    {
        ApplicationStatus.Saved     => "badge-saved",
        ApplicationStatus.Applied   => "badge-applied",
        ApplicationStatus.Interview => "badge-interview",
        ApplicationStatus.Offer     => "badge-offer",
        ApplicationStatus.Rejected  => "badge-rejected",
        _                           => ""
    };

    string StatusIcon(ApplicationStatus s) => s switch
    {
        ApplicationStatus.Saved     => "<svg class=\"status-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z\"/></svg>",
        ApplicationStatus.Applied   => "<svg class=\"status-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"22\" y1=\"2\" x2=\"11\" y2=\"13\"/><polygon points=\"22 2 15 22 11 13 2 9 22 2\"/></svg>",
        ApplicationStatus.Interview => "<svg class=\"status-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"/><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/></svg>",
        ApplicationStatus.Offer     => "<svg class=\"status-icon\" viewBox=\"0 0 24 24\" fill=\"currentColor\" stroke=\"none\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"/></svg>",
        ApplicationStatus.Rejected  => "<svg class=\"status-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"15\" y1=\"9\" x2=\"9\" y2=\"15\"/><line x1=\"9\" y1=\"9\" x2=\"15\" y2=\"15\"/></svg>",
        _                           => ""
    };

    string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : name.Length >= 2 ? name[..2].ToUpper() : name.ToUpper();
    }

    int maxCompanyCount = Model.TopCompanies.Any() ? Model.TopCompanies.Max(kv => kv.Value) : 1;
}

<div class="container py-4">

    <!-- Breadcrumb -->
    <nav class="breadcrumb-nav" aria-label="breadcrumb">
        <ol class="breadcrumb-list">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li>Dashboard</li>
        </ol>
    </nav>

    <!-- Page header -->
    <div class="page-header">
        <div>
            <h2>Dashboard</h2>
            <p class="sub">Your internship search at a glance</p>
        </div>
        <a asp-controller="JobApplications" asp-action="Create" class="btn btn-primary">
            + Add Application
        </a>
    </div>

    <!-- New-user onboarding checklist -->
    @if (Model.TotalApplications == 0)
    {
        <div class="onboarding-banner anim-fade-up anim-d1" id="onboardingBanner">
            <div class="onboarding-header">
                <div>
                    <h6>Welcome to InternTrackAI</h6>
                    <p>Three quick steps to get the most out of your internship search.</p>
                </div>
                <button type="button" class="onboarding-close" id="onboardingClose" aria-label="Dismiss">&times;</button>
            </div>
            <div class="onboarding-checklist">
                <a asp-controller="Profile" asp-action="Index" class="onboarding-step @(Model.HasProfileBasics ? "is-done" : "")">
                    <span class="onboarding-step-icon">@(Model.HasProfileBasics ? "✓" : "1")</span>
                    <span class="onboarding-step-text">Complete your profile (name &amp; skills)</span>
                    <span class="onboarding-step-arrow" aria-hidden="true">›</span>
                </a>
                <a asp-controller="Profile" asp-action="Index" class="onboarding-step @(Model.HasResume ? "is-done" : "")">
                    <span class="onboarding-step-icon">@(Model.HasResume ? "✓" : "2")</span>
                    <span class="onboarding-step-text">Upload your resume for AI matching</span>
                    <span class="onboarding-step-arrow" aria-hidden="true">›</span>
                </a>
                <a asp-controller="JobApplications" asp-action="Create" class="onboarding-step">
                    <span class="onboarding-step-icon">3</span>
                    <span class="onboarding-step-text">Add your first application</span>
                    <span class="onboarding-step-arrow" aria-hidden="true">›</span>
                </a>
            </div>
        </div>
    }

    <!-- Deadline & follow-up alerts -->
    @if (Model.UpcomingDeadlines.Any() || Model.FollowUpSuggestions.Any())
    {
        <div class="alert-section">
            @if (Model.UpcomingDeadlines.Any())
            {
                <div class="alert-card alert-card--amber mb-2">
                    <div class="alert-card-title">
                        @Model.UpcomingDeadlines.Count deadline@(Model.UpcomingDeadlines.Count == 1 ? "" : "s") in the next 3 days
                    </div>
                    @foreach (var app in Model.UpcomingDeadlines)
                    {
                        var daysLeft = (app.Deadline!.Value.Date - DateTime.UtcNow.Date).Days;
                        var urgency  = daysLeft == 0 ? "Today" : daysLeft == 1 ? "Tomorrow" : $"In {daysLeft} days";
                        <div class="alert-item">@app.CompanyName &mdash; @app.RoleTitle &mdash; @urgency</div>
                    }
                </div>
            }
            @if (Model.FollowUpSuggestions.Any())
            {
                <div class="alert-card alert-card--blue">
                    <div class="alert-card-title">Follow-up opportunities</div>
                    @foreach (var app in Model.FollowUpSuggestions)
                    {
                        var days = (DateTime.UtcNow.Date - app.DateApplied!.Value.Date).Days;
                        <div class="alert-item">@app.CompanyName &mdash; @app.RoleTitle &mdash; applied @days days ago</div>
                    }
                </div>
            }
        </div>
    }

    <!-- Stat cards (4-up) -->
    @{
        var headlineStatuses = new[] { ApplicationStatus.Applied, ApplicationStatus.Interview, ApplicationStatus.Offer };
    }
    <div class="stats-grid stats-grid-4 mb-4">
        <div class="stat-card stat-card-total anim-fade-up anim-d1">
            <div class="stat-number" data-count="@Model.TotalApplications">@Model.TotalApplications</div>
            <div class="stat-label">Total applications</div>
        </div>
        @{int delay = 2;}
        @foreach (var status in headlineStatuses)
        {
            var count = Model.StatusCounts.GetValueOrDefault(status, 0);
            <div class="stat-card stat-card-@status.ToString().ToLower() anim-fade-up anim-d@(delay)">
                <div class="stat-number" data-count="@count">@count</div>
                <div class="stat-label">@status</div>
            </div>
            delay = Math.Min(delay + 1, 6);
        }
    </div>

    <!-- Analytics grid -->
    @if (Model.TotalApplications > 0)
    {
        var pipeline = new[] { ApplicationStatus.Saved, ApplicationStatus.Applied, ApplicationStatus.Interview, ApplicationStatus.Offer, ApplicationStatus.Rejected };
        <div class="dash-grid anim-fade-up anim-d4">

            <!-- Applications over time (Chart.js) -->
            <div class="analytics-card dash-chart">
                <div class="analytics-card-head">
                    <div>
                        <div class="analytics-card-label">Applications over time</div>
                        <div class="analytics-card-sub">Submitted per month, last 6 months</div>
                    </div>
                    <span class="chart-legend"><span class="chart-legend-swatch"></span>Applications</span>
                </div>
                <div class="chart-wrap">
                    <canvas id="appsOverTimeChart" role="img" aria-label="Applications submitted per month, last 6 months"></canvas>
                </div>
            </div>

            <!-- Pipeline funnel -->
            <div class="analytics-card dash-pipeline">
                <div class="analytics-card-label">Pipeline</div>
                <div class="analytics-card-sub mb-3">Where your applications stand</div>
                <div class="funnel">
                    @foreach (var st in pipeline)
                    {
                        var c = Model.StatusCounts.GetValueOrDefault(st, 0);
                        var pct = Model.TotalApplications > 0 ? (int)Math.Round(c * 100.0 / Model.TotalApplications) : 0;
                        <div class="funnel-row funnel-@st.ToString().ToLower()">
                            <span class="funnel-label">@st</span>
                            <div class="funnel-bar-wrap"><div class="funnel-bar" style="width:@(Math.Max(pct, c > 0 ? 4 : 0))%"></div></div>
                            <span class="funnel-count">@c</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Success rate -->
            <div class="analytics-card dash-success">
                <div class="analytics-card-label">Success rate</div>
                <div class="analytics-card-value @(Model.SuccessRate >= 10 ? "value-success" : "")">
                    @Model.SuccessRate<span class="analytics-card-unit">%</span>
                </div>
                <div class="analytics-card-sub">
                    @Model.StatusCounts.GetValueOrDefault(ApplicationStatus.Offer, 0) offer@(Model.StatusCounts.GetValueOrDefault(ApplicationStatus.Offer, 0) == 1 ? "" : "s") from @Model.TotalApplications application@(Model.TotalApplications == 1 ? "" : "s")
                </div>
            </div>

            <!-- Top companies -->
            <div class="analytics-card dash-companies">
                <div class="analytics-card-label">Top companies</div>
                @if (Model.TopCompanies.Any())
                {
                    <div class="top-companies-list mt-2">
                        @foreach (var kv in Model.TopCompanies)
                        {
                            var pct = maxCompanyCount > 0 ? (int)(kv.Value * 100.0 / maxCompanyCount) : 0;
                            <div class="top-company-row">
                                <span class="top-company-name">@kv.Key</span>
                                <div class="top-company-bar-wrap">
                                    <div class="top-company-bar" style="width:@pct%"></div>
                                </div>
                                <span class="top-company-count">@kv.Value</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="analytics-card-sub">No companies yet.</div>
                }
            </div>

            <!-- Quick actions -->
            <div class="analytics-card dash-actions">
                <div class="analytics-card-label">Quick actions</div>
                <div class="quick-actions mt-2">
                    <a asp-controller="JobApplications" asp-action="Create" class="quick-action">
                        <span class="quick-action-icon quick-action-icon--accent">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        </span>
                        <span>Add application</span>
                    </a>
                    <a asp-controller="CoverLetter" asp-action="Generate" class="quick-action">
                        <span class="quick-action-icon quick-action-icon--purple">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                        </span>
                        <span>Write a cover letter</span>
                    </a>
                    <a asp-controller="Profile" asp-action="Index" class="quick-action">
                        <span class="quick-action-icon quick-action-icon--success">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </span>
                        <span>Update profile &amp; resume</span>
                    </a>
                    <a asp-controller="JobApplications" asp-action="Index" class="quick-action">
                        <span class="quick-action-icon quick-action-icon--warning">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                        </span>
                        <span>View all applications</span>
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- Recent applications -->
    <div class="app-table-wrapper anim-fade-up anim-d4">
        <div class="card-header-clean">
            <h5>Recent Applications</h5>
            <a asp-controller="JobApplications" asp-action="Index" class="btn btn-sm btn-outline-secondary">View all</a>
        </div>

        @if (!Model.RecentApplications.Any())
        {
            <div class="empty-state-illustrated">
                <svg class="empty-illustration" viewBox="0 0 120 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="25" y="22" width="70" height="68" rx="6" class="empty-illu-bg" fill="rgba(10,132,255,.10)"/>
                    <rect x="40" y="14" width="40" height="16" rx="5" class="empty-illu-top" fill="rgba(10,132,255,.35)"/>
                    <rect x="35" y="14" width="50" height="10" rx="5" fill="rgba(10,132,255,.35)"/>
                    <line x1="40" y1="48" x2="80" y2="48" class="empty-illu-line" stroke="rgba(10,132,255,.35)" stroke-width="3.5" stroke-linecap="round"/>
                    <line x1="40" y1="60" x2="72" y2="60" class="empty-illu-line" stroke="rgba(10,132,255,.35)" stroke-width="3.5" stroke-linecap="round"/>
                    <line x1="40" y1="72" x2="62" y2="72" class="empty-illu-line" stroke="rgba(10,132,255,.18)" stroke-width="3.5" stroke-linecap="round"/>
                </svg>
                <p class="empty-state-title">No applications yet</p>
                <p class="empty-state-desc">Start tracking your internship search and see your progress here.</p>
                <a asp-controller="JobApplications" asp-action="Create" class="btn btn-primary btn-sm">
                    Add your first one
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th class="ps-4">Company</th>
                            <th>Role</th>
                            <th class="d-none d-md-table-cell">Mode</th>
                            <th>Status</th>
                            <th class="d-none d-sm-table-cell">Deadline</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model.RecentApplications)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="company-avatar">@Initials(app.CompanyName)</span>
                                        <span class="company-name">@app.CompanyName</span>
                                    </div>
                                </td>
                                <td class="role-name">@app.RoleTitle</td>
                                <td class="text-muted d-none d-md-table-cell">@app.WorkMode</td>
                                <td>
                                    <span class="status-badge @BadgeClass(app.Status)">
                                        @Html.Raw(StatusIcon(app.Status)) @app.Status
                                    </span>
                                </td>
                                <td class="text-muted d-none d-sm-table-cell">
                                    @(app.Deadline.HasValue ? app.Deadline.Value.ToString("MMM d, yyyy") : "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

@section Scripts {
<script src="~/lib/chart.js/chart.umd.min.js"></script>
<script>
(function () {
    var canvas = document.getElementById('appsOverTimeChart');
    if (!canvas || typeof Chart === 'undefined') return;

    var series = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApplicationsOverTime.Select(kv => new { label = kv.Key, value = kv.Value })));
    var labels = series.map(function (p) { return p.label; });
    var values = series.map(function (p) { return p.value; });
    var maxVal = Math.max.apply(null, values.concat([0]));
    var chart;

    function cssVar(name) { return getComputedStyle(document.documentElement).getPropertyValue(name).trim(); }
    function isDark() { return document.documentElement.getAttribute('data-theme') === 'dark'; }

    function build() {
        if (chart) chart.destroy();
        var accent = cssVar('--accent') || '#0A84FF';
        var muted  = cssVar('--muted')  || '#6E6E73';
        var grid   = isDark() ? 'rgba(255,255,255,.07)' : 'rgba(0,0,0,.06)';
        var card   = cssVar('--card') || '#fff';
        var ctx    = canvas.getContext('2d');

        chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Applications',
                    data: values,
                    borderColor: accent,
                    borderWidth: 2.5,
                    tension: 0.4,
                    cubicInterpolationMode: 'monotone',
                    fill: true,
                    backgroundColor: function (c) {
                        var area = c.chart.chartArea; if (!area) return 'rgba(10,132,255,.08)';
                        var g = c.chart.ctx.createLinearGradient(0, area.top, 0, area.bottom);
                        g.addColorStop(0, 'rgba(10,132,255,.22)'); g.addColorStop(1, 'rgba(10,132,255,0)');
                        return g;
                    },
                    pointRadius: 3.5,
                    pointHoverRadius: 6,
                    pointBackgroundColor: card,
                    pointBorderColor: accent,
                    pointBorderWidth: 2,
                    pointHoverBackgroundColor: accent
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: { duration: 500, easing: 'easeOutQuart' },
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: isDark() ? '#2C2C2E' : '#1D1D1F',
                        titleColor: '#F5F5F7', bodyColor: '#F5F5F7',
                        padding: 10, cornerRadius: 10, displayColors: false,
                        callbacks: { label: function (i) { return i.parsed.y + (i.parsed.y === 1 ? ' application' : ' applications'); } }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false, drawBorder: false },
                        border: { display: false },
                        ticks: { color: muted, font: { family: cssVar('--font'), size: 12 }, padding: 8 }
                    },
                    y: {
                        beginAtZero: true,
                        suggestedMax: Math.max(4, maxVal + 1),
                        grid: { color: grid, drawBorder: false, tickLength: 0 },
                        border: { display: false, dash: [4, 4] },
                        ticks: { color: muted, precision: 0, stepSize: 1, font: { family: cssVar('--font'), size: 12 }, padding: 10, maxTicksLimit: 5 }
                    }
                }
            }
        });
    }

    build();
    new MutationObserver(function (m) {
        if (m.some(function (r) { return r.attributeName === 'data-theme'; })) build();
    }).observe(document.documentElement, { attributes: true });
})();

(function () {
    var banner = document.getElementById('onboardingBanner');
    if (!banner) return;
    if (localStorage.getItem('onboardingDismissed') === '1') {
        banner.style.display = 'none';
        return;
    }
    document.getElementById('onboardingClose').addEventListener('click', function () {
        localStorage.setItem('onboardingDismissed', '1');
        banner.style.display = 'none';
    });
})();

(function () {
    function easeOutQuart(t) { return 1 - Math.pow(1 - t, 4); }

    document.querySelectorAll('.stat-number[data-count]').forEach(function (el) {
        var target = parseInt(el.dataset.count, 10);
        if (isNaN(target) || target === 0) return;
        var start = null;
        var duration = 850;
        function step(ts) {
            if (!start) start = ts;
            var p = Math.min((ts - start) / duration, 1);
            el.textContent = Math.round(easeOutQuart(p) * target);
            if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
    });
})();
</script>
}
