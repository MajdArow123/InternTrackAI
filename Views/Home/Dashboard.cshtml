@model InternTrackAI.Models.ViewModels.DashboardViewModel
@using InternTrackAI.Models.Enums

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">

    <!-- Breadcrumb -->
    <nav class="breadcrumb-nav" aria-label="breadcrumb">
        <ol class="breadcrumb-list">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li>Dashboard</li>
        </ol>
    </nav>

    <!-- Page header -->
    <div class="page-header">
        <div>
            <h2>Dashboard</h2>
            <p class="sub">Your internship search at a glance</p>
        </div>
        <a asp-controller="JobApplications" asp-action="Create" class="btn btn-primary">
            + Add Application
        </a>
    </div>

    <partial name="_Onboarding" model="Model" />
    <partial name="_Alerts" model="Model" />
    <partial name="_StatCards" model="Model" />
    <partial name="_Analytics" model="Model" />
    <partial name="_RecentApplications" model="Model" />

</div>

@section Scripts {
<script type="application/json" id="appsOverTimeData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApplicationsOverTime.Select(kv => new { label = kv.Key, value = kv.Value })))</script>
<script src="~/lib/chart.js/chart.umd.min.js"></script>
<script src="~/js/dashboard.js" asp-append-version="true"></script>
<script src="~/js/reminders.js" asp-append-version="true"></script>
}
