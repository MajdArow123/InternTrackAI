@model InternTrackAI.Models.ViewModels.DashboardViewModel
@using InternTrackAI.Services
@{
    var sg = Model.SkillGaps;
}
@if (!sg.Hide)
{
    <!-- Skills you're missing most: aggregated MissingSkillsJson (SkillGapService); chart data in #skillGapData -->
    <section class="analytics-card dash-skillgap" id="skillGapCard" aria-labelledby="skillGapTitle"
             data-applications-url="@Url.Action("Index", "JobApplications")">
        <div class="analytics-card-head">
            <div>
                <div class="analytics-card-label skill-gap-title">
                    <h3 id="skillGapTitle">Skills you're missing most</h3>
                    <button type="button" class="skill-gap-info" id="skillGapInfo"
                            data-bs-toggle="tooltip" data-bs-placement="top"
                            data-bs-title="Across the postings you've analyzed, these are the requirements your active resume didn't cover."
                            aria-label="About this chart: across the postings you've analyzed, these are the requirements your active resume didn't cover.">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><line x1="12" y1="11" x2="12" y2="16.5"/><circle cx="12" cy="7.75" r=".6" fill="currentColor"/></svg>
                    </button>
                </div>
                <div class="analytics-card-sub">From your analyzed applications &middot; Applied or later</div>
            </div>
        </div>

        @if (sg.LowSample)
        {
            <p class="skill-gap-note" id="skillGapLowSample">Based on @sg.AnalyzedApplications applications &mdash; the picture gets clearer as you analyze more.</p>
        }

        @if (sg.ShowRoleFilter)
        {
            <div class="filter-pills skill-gap-roles" id="skillGapRoles" role="group" aria-label="Filter by target role">
                <button type="button" class="filter-pill active" data-bucket="@SkillGapService.AllKey" aria-pressed="true">All</button>
                @foreach (var role in sg.Roles)
                {
                    <button type="button" class="filter-pill" data-bucket="@role.Key" aria-pressed="false">@role.Label</button>
                }
                @if (sg.Other is not null)
                {
                    <button type="button" class="filter-pill" data-bucket="@SkillGapService.OtherKey" aria-pressed="false">Other</button>
                }
            </div>
        }

        <p class="skill-gap-takeaway" id="skillGapTakeaway" aria-live="polite">@sg.All.Takeaway</p>

        <div class="skill-gap-body">
            <div class="skill-gap-chart" id="skillGapChart">
                <canvas id="skillGapCanvas" aria-hidden="true"></canvas>
                <div class="skill-gap-hits" id="skillGapHits" role="list" aria-label="Missing skills, most common first"></div>
            </div>
            <div class="skill-gap-detail" id="skillGapDetail" aria-live="polite">
                <p class="skill-gap-hint" id="skillGapHint">Select a skill to see which applications asked for it.</p>
                <div class="skill-gap-panel" id="skillGapPanel" hidden>
                    <div class="skill-gap-panel-head">
                        <div>
                            <div class="skill-gap-panel-title" id="skillGapPanelTitle"></div>
                            <div class="skill-gap-panel-sub" id="skillGapPanelSub"></div>
                        </div>
                        <button type="button" class="skill-gap-panel-close" id="skillGapPanelClose" aria-label="Close application list">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
                        </button>
                    </div>
                    <ul class="skill-gap-apps" id="skillGapApps"></ul>
                    <p class="skill-gap-more" id="skillGapMore" hidden></p>
                </div>
            </div>
        </div>
    </section>
}
