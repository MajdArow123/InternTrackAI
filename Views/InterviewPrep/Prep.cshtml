@model InternTrackAI.Models.ViewModels.InterviewPrepViewModel

@{
    ViewData["Title"] = "Interview Prep";
    var clock = await Clocks.GetAsync();
    var app = Model.Application;
}

<div class="container py-4 container-narrow">

    <nav class="breadcrumb-nav" aria-label="breadcrumb">
        <ol class="breadcrumb-list">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li><a asp-controller="JobApplications" asp-action="Index">Applications</a></li>
            <li>Interview Prep</li>
        </ol>
    </nav>

    <div class="page-header">
        <div>
            <h1>Interview prep</h1>
            <p class="sub">AI-generated questions tailored to this role and your resume</p>
        </div>
        <a asp-controller="JobApplications" asp-action="Index" class="btn btn-outline-secondary">Applications</a>
    </div>

    <!-- Job info card -->
    <div class="form-card mb-3">
        <div class="d-flex align-items-center gap-3">
            <div class="company-avatar company-avatar--lg">
                @{
                    var parts  = app.CompanyName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                    var initials = parts.Length >= 2
                        ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
                        : app.CompanyName.Length >= 2 ? app.CompanyName[..2].ToUpper() : app.CompanyName.ToUpper();
                }
                @initials
            </div>
            <div>
                <div class="prep-company">@app.CompanyName</div>
                <div class="prep-role">@app.RoleTitle@(app.Location != null ? " · " + app.Location : "")</div>
            </div>
        </div>
    </div>

    <!-- Generate card -->
    <div class="form-card mb-3">
        <p class="form-section-title">Generate interview questions</p>

        @if (Model.GeneratedAt is { } generatedAt)
        {
            <p class="form-hint mb-3" id="prepGeneratedAt">
                Last generated on @clock.LocalDateTime(generatedAt).
                Regenerate to add a fresh set based on your current resume and skills &mdash; questions you already have aren't repeated.
            </p>
        }
        else
        {
            <p class="form-hint mb-3" id="prepGeneratedAt">
                The AI will generate 8–10 interview questions covering Technical, Behavioral, and
                Company-Specific topics, using the job description and your active resume.
            </p>
        }

        @* One token for the page: interview-prep.js sends it with Generate, practice.js with each answer. *@
        <div data-practice-token>@Html.AntiForgeryToken()</div>
        <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn btn-primary px-4" id="prepGenerateBtn" data-app-id="@app.Id">
                @(Model.GeneratedAt is null ? "Generate interview prep" : "Regenerate")
            </button>
            <span class="form-hint mt-0">Powered by GPT-4o mini</span>
        </div>
        <p class="form-hint mt-3 mb-0" id="prepNote" role="status" hidden></p>
        <div class="match-error-banner mt-3" id="prepError" role="alert" hidden></div>
    </div>

    @*
        Always rendered, even with no questions yet: practice.js binds answering to #practiceList once, at
        load, and delegation then covers every card Generate appends. Newly generated questions are merged
        into these sections — never swapped in for them — so a regenerate that stores nothing leaves the
        page exactly as it was.
    *@
    <div id="practiceList" class="prep-questions">
        <partial name="_PrepQuestionGroups" model="Model.Questions" />
    </div>

    <div class="ai-shimmer-wrap mb-4" id="prepGenerating" hidden aria-hidden="true">
        <div class="shimmer-bar w-half"></div>
        <div class="shimmer-bar w-full"></div>
        <div class="shimmer-bar w-three"></div>
    </div>

</div>

@section Scripts {
    <script src="~/js/practice.js" asp-append-version="true"></script>
    <script src="~/js/interview-prep.js" asp-append-version="true"></script>
}
