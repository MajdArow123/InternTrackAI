@model InternTrackAI.Models.JobApplication

@{
    ViewData["Title"] = "Edit Application";
    var clock = await Clocks.GetAsync();
}

<div class="container py-4 container-narrow">

    <nav class="breadcrumb-nav" aria-label="breadcrumb">
        <ol class="breadcrumb-list">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li><a asp-controller="JobApplications" asp-action="Index">Applications</a></li>
            <li>Edit</li>
        </ol>
    </nav>

    <div class="page-header">
        <div>
            <h1>Edit Application</h1>
            <p class="sub">Update the details for @Model.CompanyName</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>

    @if (ViewBag.DuplicateWarning == true)
    {
        <div class="duplicate-warning mb-3" id="duplicateWarning">
            <div class="d-flex align-items-start gap-2">
                <div class="flex-1">
                    <strong>Possible duplicate</strong> — you already have another application for
                    <strong>@Model.CompanyName</strong> &mdash; <strong>@Model.RoleTitle</strong>.
                    Review your existing applications or save anyway if this is intentional.
                </div>
            </div>
            <div class="mt-2 d-flex gap-2">
                <button type="button" class="btn btn-sm btn-primary" id="saveAnywayBtn">Save Anyway</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to Applications</a>
            </div>
        </div>
    }

    <form asp-action="Edit" method="post" id="appForm">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" name="forceSave" id="forceSave" value="false" />

        <!-- AI match data isn't editable on this page (only the analyzer on Create sets it),
             but model binding still requires these fields to round-trip the existing values —
             without them, posting the form would bind them to null and Update() would overwrite
             the stored match score/skills with empty data. -->
        <input type="hidden" asp-for="MatchScore" />
        <input type="hidden" asp-for="MatchRecommendation" />
        <input type="hidden" asp-for="MatchSummary" />
        <input type="hidden" asp-for="MatchingSkillsJson" />
        <input type="hidden" asp-for="MissingSkillsJson" />
        <!-- Same round-trip reasoning: LastContactAt is set by "Mark contacted", BoardOrder by the board. -->
        <input type="hidden" name="LastContactAt" value="@(Model.LastContactAt?.ToString("yyyy-MM-ddTHH:mm:ss"))" />
        <input type="hidden" asp-for="BoardOrder" />

        <!-- Core info -->
        <div class="form-card mb-3">
            <p class="form-section-title">Core info</p>
            <div class="row g-3">
                <div class="col-sm-6">
                    <label asp-for="CompanyName" class="form-label">Company</label>
                    <input asp-for="CompanyName" class="form-control" placeholder="e.g. Stripe" />
                    <span asp-validation-for="CompanyName" class="text-danger field-validation-error"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="RoleTitle" class="form-label">Role Title</label>
                    <input asp-for="RoleTitle" class="form-control" placeholder="e.g. Software Engineering Intern" />
                    <span asp-validation-for="RoleTitle" class="text-danger field-validation-error"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Location" class="form-label">Location <span class="text-muted fw-normal">(optional)</span></label>
                    <input asp-for="Location" class="form-control" placeholder="e.g. San Francisco, CA" />
                </div>
                <div class="col-sm-6">
                    <label asp-for="JobLink" class="form-label">Job Link <span class="text-muted fw-normal">(optional)</span></label>
                    <input asp-for="JobLink" class="form-control" placeholder="https://..." />
                    <span asp-validation-for="JobLink" class="text-danger field-validation-error"></span>
                </div>
            </div>
        </div>

        <!-- Status & Dates -->
        <div class="form-card mb-3">
            <p class="form-section-title">Status &amp; dates</p>
            <div class="row g-3">
                <div class="col-sm-4">
                    <label asp-for="Status" class="form-label">Status</label>
                    <select asp-for="Status" class="form-select"
                            asp-items="Html.GetEnumSelectList<InternTrackAI.Models.Enums.ApplicationStatus>()"></select>
                </div>
                <div class="col-sm-4">
                    <label asp-for="WorkMode" class="form-label">Work Mode</label>
                    <select asp-for="WorkMode" class="form-select"
                            asp-items="Html.GetEnumSelectList<InternTrackAI.Models.Enums.WorkMode>()"></select>
                </div>
                <div class="col-sm-4">
                    <label asp-for="Salary" class="form-label">Salary <span class="text-muted fw-normal">(optional)</span></label>
                    <input asp-for="Salary" class="form-control" placeholder="e.g. $30/hr" />
                    <button type="button" class="btn btn-link p-0 mt-1 small" id="salaryInsightBtn">Get salary insight</button>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Deadline" class="form-label">Application Deadline</label>
                    <input asp-for="Deadline" class="form-control" type="date" />
                </div>
                <div class="col-sm-6">
                    <label asp-for="DateApplied" class="form-label">Date Applied</label>
                    <input asp-for="DateApplied" class="form-control" type="date" />
                </div>
                <div class="col-sm-6">
                    <label asp-for="InterviewAt" class="form-label">Interview <span class="text-muted fw-normal">(date &amp; time, optional)</span></label>
                    <input asp-for="InterviewAt" class="form-control" type="datetime-local" />
                </div>
                <div class="col-sm-6">
                    <label asp-for="FollowUpAt" class="form-label">Follow-up date <span class="text-muted fw-normal">(optional)</span></label>
                    <input asp-for="FollowUpAt" class="form-control" type="date" />
                    <div class="form-hint mt-1">The follow-up reminder stays quiet until this date.</div>
                </div>
                <div class="col-sm-6">
                    <label for="resumeVersionSelect" class="form-label">Resume used <span class="text-muted fw-normal">(optional)</span></label>
                    <select asp-for="ResumeVersionId" class="form-select" id="resumeVersionSelect">
                        <option value="">None</option>
                        @foreach (var r in (ViewBag.ResumeOptions as IEnumerable<InternTrackAI.Models.ResumeVersion>) ?? Enumerable.Empty<InternTrackAI.Models.ResumeVersion>())
                        {
                            <option value="@r.Id">v@(r.VersionNumber) &middot; @r.DisplayName@(r.IsActive ? " (active)" : "")</option>
                        }
                    </select>
                    <div class="form-hint mt-1">Which resume version this application was sent with. Drives the resume performance card on the dashboard.</div>
                </div>
                <div class="col-12 d-flex align-items-center gap-2 flex-wrap">
                    <span class="text-muted small" id="lastContactedText">Last contacted: @clock.LocalDate(Model.LastContactAt, "never")</span>
                    <!-- Belongs to the separate #mark-contacted-form below (HTML form= attribute), so it can't be nested. -->
                    <button type="submit" form="mark-contacted-form" class="btn btn-sm btn-outline-primary" id="markContactedBtn">Mark contacted today</button>
                </div>
                <div class="col-12">
                    <div class="salary-insight-card mt-1" id="salaryInsightCard" hidden></div>
                    <div class="match-error-banner mt-2" id="salaryInsightError" hidden></div>
                </div>
            </div>
        </div>

        <!-- Notes -->
        <div class="form-card mb-4">
            <p class="form-section-title">Job description &amp; notes</p>
            <label asp-for="JobDescription" class="form-label">Job description / notes <span class="text-muted fw-normal">(optional)</span></label>
            <textarea asp-for="JobDescription" class="form-control" placeholder="Paste the job description or add notes..."></textarea>
        </div>

        @* Edit has no analyzer panel, so keyword coverage gets its own card here. It reads the posting that
           is already saved, so it reflects the last save rather than unsaved edits to the textarea above. *@
        <div class="form-card mb-4">
            <partial name="_KeywordCoverage" model="@((int?)Model.Id)" />
        </div>

        <div class="d-flex gap-2 form-actions">
            <button type="submit" class="btn btn-primary px-4">Save changes</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <a asp-action="Delete" asp-route-id="@Model.Id"
               class="btn btn-outline-danger ms-auto">Delete</a>
        </div>
    </form>

    <!-- Plain POST (no JS needed): sets LastContactAt = now and comes back here with a toast. -->
    <form id="mark-contacted-form" method="post" asp-action="MarkContacted" asp-route-id="@Model.Id" hidden>
        @Html.AntiForgeryToken()
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/duplicate-warning.js" asp-append-version="true"></script>
    <script src="~/js/salary-insight.js" asp-append-version="true"></script>
    <script src="~/js/keyword-coverage.js" asp-append-version="true"></script>
}
