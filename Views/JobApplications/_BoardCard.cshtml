@model InternTrackAI.Models.JobApplication
@using InternTrackAI.Services
@{
    // Same data-* contract as the list rows in _Table.cshtml so app-drawer.js can open the
    // detail drawer from a card. Free-text fields are URI-escaped for attribute safety.
    // Reminder state comes from ReminderService via ViewBag.AttentionById (set by the controller).
    var byId      = ViewBag.AttentionById as Dictionary<int, List<ReminderItem>>;
    var resumes   = ViewBag.ResumeLabels as Dictionary<int, string>;
    var reminders = byId != null && byId.TryGetValue(Model.Id, out var found) ? found : new List<ReminderItem>();
    var clock     = await Clocks.GetAsync();
    var deadline  = ReminderService.DeadlineChip(Model, clock.Today);
    bool followUpDue = reminders.Any(r => r.Kind == ReminderKind.FollowUpDue);
    var interview    = reminders.FirstOrDefault(r => r.Kind == ReminderKind.Interview);
}
<article class="board-card app-row"
         data-app-id="@Model.Id"
         data-company="@Model.CompanyName"
         data-role="@Model.RoleTitle"
         data-location="@(Model.Location ?? "")"
         data-salary="@(Model.Salary ?? "")"
         data-match-score="@(Model.MatchScore?.ToString() ?? "")"
         data-match-rec="@(Model.MatchRecommendation ?? "")"
         data-match-summary="@(Uri.EscapeDataString(Model.MatchSummary ?? ""))"
         data-matching-skills="@(Uri.EscapeDataString(Model.MatchingSkillsJson ?? "[]"))"
         data-missing-skills="@(Uri.EscapeDataString(Model.MissingSkillsJson ?? "[]"))"
         data-status="@((int)Model.Status)"
         data-deadline="@clock.Date(Model.Deadline)"
         data-interview-at="@clock.LocalDateTime(Model.InterviewAt)"
         data-follow-up-at="@clock.LocalDate(Model.FollowUpAt)"
         data-last-contact-at="@clock.LocalDate(Model.LastContactAt)"
         data-follow-up-due="@(followUpDue ? "1" : "")"
         data-has-dates="@(Model.Deadline.HasValue || Model.InterviewAt.HasValue || Model.FollowUpAt.HasValue ? "1" : "")"
         data-mode="@Model.WorkMode"
         data-resume="@(ResumeDisplay.Label(Model.ResumeVersionId, resumes) ?? "")"
         data-job-description="@(Uri.EscapeDataString(Model.JobDescription ?? ""))"
         role="button"
         tabindex="0"
         aria-label="@Model.CompanyName, @Model.RoleTitle">
    <div class="board-card-top">
        <div class="board-card-text">
            <div class="board-card-company">@Model.CompanyName</div>
            <div class="board-card-role">@Model.RoleTitle</div>
        </div>
        @if (Model.MatchScore.HasValue)
        {
            var tooltip = $"{Model.MatchScore}% Match · {StatusDisplay.MatchTooltip(Model.MatchScore.Value)}";
            <span class="match-ring match-ring--sm match-ring--tier-@StatusDisplay.MatchTier(Model.MatchScore.Value)"
                  style="--p:@Model.MatchScore"
                  data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="@tooltip"
                  aria-label="@tooltip"><span>@Model.MatchScore</span></span>
        }
    </div>
    <div class="board-card-date">
        @(Model.DateApplied.HasValue ? $"Applied {clock.Date(Model.DateApplied)}" : "Not applied yet")
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Salary) || deadline != null || followUpDue || interview != null)
    {
        <div class="board-tags">
            @if (!string.IsNullOrWhiteSpace(Model.Salary))
            {
                <span class="board-tag">@Model.Salary</span>
            }
            @if (deadline != null)
            {
                <span class="board-tag @(deadline.Value.Tone == "" ? "" : "board-tag--" + deadline.Value.Tone)">@deadline.Value.Text</span>
            }
            @if (followUpDue)
            {
                <span class="board-tag board-tag--warning board-tag--followup">Follow up</span>
            }
            @if (interview != null)
            {
                <span class="board-tag board-tag--accent">@interview.Reason</span>
            }
        </div>
    }
</article>
