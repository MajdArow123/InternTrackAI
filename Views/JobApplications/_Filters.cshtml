@using InternTrackAI.Models.Enums
@{
    bool isFiltered = ViewBag.IsFiltered == true;
    int  totalCount = ViewBag.TotalCount ?? 0;
    // Both the list (Index) and the Kanban board (Board) render this partial; links and the
    // filter form post back to whichever page is showing.
    string filterAction = ViewData["FilterAction"] as string ?? "Index";
    bool   isBoard      = filterAction == "Board";
}
    <!-- ── Status filter pills ── -->
    @{
        string curStatus   = ViewBag.Status ?? "";
        string curSearch   = ViewBag.Search ?? "";
        string curWorkMode = ViewBag.WorkMode ?? "";
        string curSort     = ViewBag.SortBy ?? "";
        var pillOrder = new[] { ApplicationStatus.Saved, ApplicationStatus.Applied, ApplicationStatus.Interview, ApplicationStatus.Offer, ApplicationStatus.Rejected };
    }
    <div class="filter-pills mb-3" role="navigation" aria-label="Filter by status">
        <a class="filter-pill @(curStatus == "" ? "active" : "")"
           asp-action="@filterAction" asp-route-search="@curSearch" asp-route-workMode="@curWorkMode" asp-route-sortBy="@curSort">
            All <span class="filter-pill-count">@totalCount</span>
        </a>
        @foreach (var st in pillOrder)
        {
            <a class="filter-pill filter-pill-@st.ToString().ToLower() @(curStatus == st.ToString() ? "active" : "")"
               asp-action="@filterAction" asp-route-status="@st" asp-route-search="@curSearch" asp-route-workMode="@curWorkMode" asp-route-sortBy="@curSort">
                <span class="filter-pill-dot"></span>@st
            </a>
        }
        <div class="view-toggle" role="group" aria-label="View">
            <a class="filter-pill @(isBoard ? "" : "active")" aria-current="@(isBoard ? null : "page")"
               asp-action="Index" asp-route-view="list" asp-route-search="@curSearch" asp-route-status="@curStatus" asp-route-workMode="@curWorkMode" asp-route-sortBy="@curSort">List</a>
            <a class="filter-pill @(isBoard ? "active" : "")" aria-current="@(isBoard ? "page" : null)"
               asp-action="Board" asp-route-search="@curSearch" asp-route-status="@curStatus" asp-route-workMode="@curWorkMode" asp-route-sortBy="@curSort">Board</a>
        </div>
    </div>

    <!-- ── Filter Bar ── -->
    <form method="get" asp-action="@filterAction" class="filter-bar mb-3">
        <input type="hidden" name="status" value="@curStatus" />
        <div class="filter-group filter-group-search">
            <label class="filter-label" for="filterSearch">Search</label>
            <div class="filter-search-wrap">
                <svg class="filter-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" name="search" id="filterSearch" class="form-control"
                       placeholder="Company or role..."
                       value="@ViewBag.Search" />
            </div>
        </div>
        <div class="filter-group">
            <label class="filter-label">Work Mode</label>
            <select name="workMode" class="form-select">
                <option value="">All Modes</option>
                @foreach (var wm in Enum.GetValues<WorkMode>())
                {
                    if (ViewBag.WorkMode == wm.ToString())
                    {
                        <option value="@wm" selected>@wm</option>
                    }
                    else
                    {
                        <option value="@wm">@wm</option>
                    }
                }
            </select>
        </div>
        @if (!isBoard)
        {
        <div class="filter-group">
            <label class="filter-label">Sort By</label>
            <select name="sortBy" class="form-select">
                @{
                    string sb = ViewBag.SortBy ?? "";
                }
                @if (sb == "") { <option value="" selected>Newest First</option> }
                else           { <option value="">Newest First</option> }

                @if (sb == "company") { <option value="company" selected>Company A–Z</option> }
                else                  { <option value="company">Company A–Z</option> }

                @if (sb == "deadline") { <option value="deadline" selected>Deadline</option> }
                else                   { <option value="deadline">Deadline</option> }

                @if (sb == "dateApplied") { <option value="dateApplied" selected>Date Applied</option> }
                else                      { <option value="dateApplied">Date Applied</option> }

                @if (sb == "status") { <option value="status" selected>Status</option> }
                else                 { <option value="status">Status</option> }
            </select>
        </div>
        }
        <div class="d-flex gap-2 align-self-end filter-actions">
            <button type="submit" class="btn btn-primary filter-apply-btn">Apply</button>
            @if (isFiltered)
            {
                <a asp-action="@filterAction" class="btn btn-outline-secondary filter-apply-btn">Clear</a>
            }
        </div>
    </form>
