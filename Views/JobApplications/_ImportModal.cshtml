<!-- ── Import CSV Modal ── -->
<div id="import-overlay" class="compare-modal-overlay" aria-hidden="true" role="dialog" aria-label="Import applications from CSV">
    <div class="compare-modal" style="max-width:480px">
        <div class="compare-modal-header">
            <span class="compare-modal-title">Import Applications</span>
            <button class="compare-modal-close" id="import-close" aria-label="Close">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <form asp-action="ImportCsv" method="post" enctype="multipart/form-data" class="p-3 p-sm-4">
            <p class="text-muted small mb-3">
                Upload a CSV file with columns: Company, Role, Location, Work Mode, Status, Deadline,
                Date Applied, Salary, Job Link. Only Company and Role are required &mdash; this matches
                the format produced by <strong>Export CSV</strong>.
            </p>
            <input type="file" name="file" accept=".csv" class="form-control mb-3" required />
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="import-cancel">Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm">Import</button>
            </div>
        </form>
    </div>
</div>
