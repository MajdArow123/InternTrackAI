@model InternTrackAI.Models.ViewModels.PracticeViewModel
@using InternTrackAI.Models.Enums
@{
    ViewData["Title"] = "Practice";

    string FilterUrl(PracticeDifficulty? d, QuestionCategory? c, bool saved, bool hideAnswered) =>
        Url.Action("Index", new
        {
            difficulty   = d?.ToString(),
            category     = c?.ToString(),
            saved        = saved ? "true" : null,
            hideAnswered = hideAnswered ? "true" : null
        })!;
}

<div class="container py-4 container-narrow">

    <nav class="breadcrumb-nav" aria-label="breadcrumb">
        <ol class="breadcrumb-list">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li>Practice</li>
        </ol>
    </nav>

    <div class="page-header">
        <div>
            <h1>Practice</h1>
            <p class="sub">Interview questions in your field, at the level you pick</p>
        </div>
    </div>

@if (!Model.Progress.IsEmpty)
{
    <partial name="_PracticeProgress" model="Model.Progress" />
}

    <div class="form-card mb-3">
        <p class="form-section-title">Difficulty and category</p>
        <p class="form-hint mb-3">
            These filter what's listed below <strong>and</strong> decide what &ldquo;Get more questions&rdquo; writes next.
        </p>

        <div class="practice-filters">
            <div class="practice-filter-group" role="group" aria-label="Difficulty">
                <a class="practice-filter @(Model.Difficulty is null ? "is-active" : "")" href="@FilterUrl(null, Model.Category, Model.SavedOnly, Model.HideAnswered)">Any</a>
                @foreach (var d in Enum.GetValues<PracticeDifficulty>())
                {
                    <a class="practice-filter @(Model.Difficulty == d ? "is-active" : "")" href="@FilterUrl(d, Model.Category, Model.SavedOnly, Model.HideAnswered)">@d</a>
                }
            </div>

            <div class="practice-filter-group" role="group" aria-label="Category">
                <a class="practice-filter @(Model.Category is null ? "is-active" : "")" href="@FilterUrl(Model.Difficulty, null, Model.SavedOnly, Model.HideAnswered)">Any</a>
                @foreach (var c in QuestionCategories.InOrder)
                {
                    <a class="practice-filter @(Model.Category == c ? "is-active" : "")" href="@FilterUrl(Model.Difficulty, c, Model.SavedOnly, Model.HideAnswered)">@QuestionCategories.Display(c)</a>
                }
            </div>

            @*
                A plain filter, unlike the two above — it narrows the list and has no say in what the
                next batch generates. It composes with them: saved + Hard is your saved Hard questions.
            *@
            <div class="practice-filter-group" role="group" aria-label="Saved and answered">
                <a class="practice-filter @(Model.SavedOnly ? "is-active" : "")"
                   href="@FilterUrl(Model.Difficulty, Model.Category, !Model.SavedOnly, Model.HideAnswered)"
                   aria-pressed="@(Model.SavedOnly ? "true" : "false")">★ Saved</a>
                <a class="practice-filter @(Model.HideAnswered ? "is-active" : "")"
                   href="@FilterUrl(Model.Difficulty, Model.Category, Model.SavedOnly, !Model.HideAnswered)"
                   aria-pressed="@(Model.HideAnswered ? "true" : "false")">Hide answered</a>
            </div>
        </div>

        <div class="practice-bulk-toggle" id="practiceBulkToggle" hidden>
            <button type="button" class="practice-filter" data-practice-toggle-all="collapse">Collapse all</button>
            <button type="button" class="practice-filter" data-practice-toggle-all="expand">Expand all</button>
        </div>

        <form id="practiceGenerateForm" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="difficulty" value="@Model.NextDifficulty" />
            <input type="hidden" name="category" value="@Model.NextCategory" />
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary" id="practiceGenerateBtn">
                    <span id="practiceGenerateLabel">Get more questions</span>
                </button>
                @*
                    Spelled out because "Any / Any" above a button labelled "Medium · Technical" reads
                    as a bug. The filters and the generator genuinely differ when a filter is unset,
                    so the copy says which is which rather than hiding it.
                *@
                <span class="form-hint mt-0">
                    Showing @(Model.Difficulty?.ToString() ?? "any difficulty") &middot; @(Model.Category is { } sc ? QuestionCategories.Display(sc) : "any category")
                    &mdash; generating <strong>@Model.NextDifficulty &middot; @QuestionCategories.Display(Model.NextCategory)</strong>
                </span>
            </div>
        </form>

        <div id="practiceNote" class="form-hint mb-0 mt-2" hidden></div>
        <div id="practiceError" class="match-error-banner mt-2" hidden></div>
    </div>

    <div id="practiceList" class="practice-list">
        @foreach (var group in Model.Groups)
        {
            <partial name="_PracticeGroup" model="group" />
        }
    </div>

@*
    Only rendered when the list is empty — practice.js hides it after the first append. Emitting it
    hidden would put "No questions yet" in the markup of a page that is full of questions.
*@
@if (Model.ShownCount > 0)
{
    @*
        The same action as the button at the top. After answering five questions the top of the page
        is a long way away, and scrolling back up to ask for more is the friction this removes.
    *@
    <div class="practice-list-footer">
        <button type="button" class="btn btn-outline-primary" data-practice-generate-more>Get more questions</button>
        <span class="form-hint mt-0">@Model.NextDifficulty &middot; @QuestionCategories.Display(Model.NextCategory)</span>
    </div>
}

@if (Model.ShownCount == 0)
{
    <div id="practiceEmpty" class="form-card">
        @if (Model.FilteredToNothing)
        {
            <p class="form-section-title form-section-title--sm mb-1">Nothing at this level yet</p>
            <p class="form-hint mb-0">
                @if (Model.HideAnswered)
                {
                    <text>You've answered everything that matches these filters.</text>
                }
                else
                {
                    <text>You have @Model.TotalCount question@(Model.TotalCount == 1 ? "" : "s") in other difficulties, categories or unsaved.</text>
                }
                <a href="@FilterUrl(null, null, false, false)">Clear the filters</a> or get more to fill this one in.
            </p>
        }
        else
        {
            <p class="form-section-title form-section-title--sm mb-1">No questions yet</p>
            <p class="form-hint mb-0">Pick a difficulty and category, then get your first set. Questions you generate from an application's interview prep show up here too.</p>
        }
    </div>
}
</div>

@*
    The batch bar. Sticky at the foot of the viewport, hidden until at least one card has enough text
    to be worth scoring — a bar that is always there but usually disabled is furniture.
*@
<div id="practiceBatchBar" class="practice-batch-bar" hidden>
    <div class="practice-batch-inner">
        <button type="button" class="btn btn-primary" id="practiceBatchBtn">
            <span id="practiceBatchLabel">Get feedback on all answers</span>
        </button>
        <span class="form-hint mt-0" id="practiceBatchNote"></span>
    </div>
</div>

@section Scripts {
    <script src="~/js/practice.js" asp-append-version="true"></script>
}
