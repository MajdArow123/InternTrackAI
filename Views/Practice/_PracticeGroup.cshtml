@model InternTrackAI.Models.ViewModels.PracticeGroup
@*
    One application's questions, under a header that names the posting and links back to it. Questions
    generated from the practice page itself fall into the general group, which shows no heading when it
    is the only group — "General practice" above the only list on the page labels nothing.

    The section wraps its own cards so a new batch can be inserted into the group it belongs to.
    Without the wrapper the headers and cards are flat siblings and an append lands under whichever
    header happens to be first, which is not where the questions belong.
*@
<section class="practice-group" data-group-id="@Model.ApplicationId">
    @if (!Model.IsGeneral)
    {
        <div class="practice-group-header">
            <div class="practice-group-titles">
                <span class="practice-group-role">@(Model.Role ?? "This role")</span>
                <span class="practice-group-company">@(Model.Company ?? "an application you no longer have")</span>
            </div>
            <div class="practice-group-actions">
                @if (Model.ApplicationUrl is { } url)
                {
                    <a class="practice-group-link" href="@url">Open application</a>
                }
                @*
                    Posts the same /Practice/GenerateMore the page-level button does, with this
                    posting's id — so the questions are derived from its description and land back here.
                *@
                <button type="button" class="btn btn-sm btn-outline-primary"
                        data-practice-generate-for="@Model.ApplicationId">Get more for this role</button>
            </div>
        </div>
    }
    else if (!Model.IsOnlyGroup)
    {
        <p class="practice-group-general">General practice</p>
    }

    <div class="practice-group-list">
        @if (Model.IsGeneral)
        {
            @*
                General practice is a record of sessions, so it is split by the day each question was
                written — in the user's own zone, via UserClock, so "Today" in Toronto and in Berlin are
                each that person's today. Application groups are not split: they are already grouped by
                posting, and a second axis inside them would fight the first.

                A "Today" block is always emitted, hidden when it has nothing in it, because that is where
                "Get more" appends. Without it the first batch of a new day would land under "Yesterday",
                and building the block in JS would be a second copy of this markup.
            *@
            var clock = await Clocks.GetAsync();
            var today = clock.Today;
            var days = Model.Questions
                .GroupBy(q => clock.ToLocal(q.CreatedAt).Date)
                .OrderByDescending(d => d.Key)
                .ToList();

            if (days.All(d => d.Key != today))
            {
                <div class="practice-day" data-practice-today hidden>
                    <p class="practice-day-label">Today</p>
                    <div class="practice-day-list"></div>
                </div>
            }

            foreach (var day in days)
            {
                var label = day.Key == today ? "Today"
                          : day.Key == today.AddDays(-1) ? "Yesterday"
                          : day.Key.Year == today.Year
                              ? day.Key.ToString("dddd, MMM d", System.Globalization.CultureInfo.InvariantCulture)
                              : day.Key.ToString(UserClock.DateFormat, System.Globalization.CultureInfo.InvariantCulture);

                <div class="practice-day" data-practice-day="@day.Key.ToString("yyyy-MM-dd")" @(day.Key == today ? "data-practice-today" : null)>
                    <p class="practice-day-label">@label</p>
                    <div class="practice-day-list">
                        <partial name="_PracticeQuestions" model="day.ToList()" />
                    </div>
                </div>
            }
        }
        else
        {
            <partial name="_PracticeQuestions" model="Model.Questions" />
        }
    </div>
</section>
