@model InternTrackAI.Models.PracticeQuestion
@using InternTrackAI.Models.Enums
@using InternTrackAI.Services
@*
    One question card, in whichever state it is in. Rendered on first load, by /Practice/GenerateMore
    and by /Practice/SubmitAnswer — which is why the answered state lives here rather than in JS: the
    card a user has just answered is built by the same code as the card they reload the page to.
*@
@{
    var answered = Model.AnsweredAt is not null;

    // FromJson never throws, so a row whose stored feedback is unreadable renders as a thin card
    // rather than 500-ing the page it appears on.
    var feedback = answered ? AnswerFeedback.FromJson(Model.AiFeedback) : null;
    var improvements = feedback?.Improvements.Where(i => i.Length > 0).ToList() ?? new List<string>();
    var attempts = AttemptHistory.Read(Model.PriorAttemptsJson);

    var score = Model.Score ?? 0;
    var scoreTone = score >= 4 ? "high" : score == 3 ? "mid" : "low";

    // Set only by SubmitAnswer, for the card just scored. Everything Index renders comes back
    // collapsed — five answered cards expanded is a very long page, and the one you want open is the
    // one you just finished.
    var expanded = ViewData["Expanded"] as bool? ?? false;
}

<div class="practice-card @(answered ? $"practice-card--scored-{scoreTone}" : "")"
     data-question-id="@Model.Id"
     data-answered="@(answered ? "true" : "false")"
     data-tour="@(answered ? "practice-answered" : "practice-question")">
    <div class="practice-card-meta">
        <span class="practice-badge practice-badge--@Model.Difficulty.ToString().ToLowerInvariant()">@Model.Difficulty</span>
        <span class="practice-badge practice-badge--category">@QuestionCategories.Display(Model.Category)</span>
        @if (!string.IsNullOrWhiteSpace(Model.Topic))
        {
            <span class="practice-topic">@Model.Topic</span>
        }
        @if (answered)
        {
            <span class="practice-score practice-score--@scoreTone" title="Your score on this answer">@score<span class="practice-score-max">/@AnswerFeedback.MaxScore</span></span>

            @*
                Muted and small on purpose: real interviews are timed, so how long an answer took is
                useful on its own — but it is not a score, and it must not read like one.
            *@
            @if (Model.AnsweredInSeconds is { } seconds)
            {
                var shown = seconds < 60 ? $"{seconds}s" : $"{seconds / 60}m {seconds % 60:00}s";
                <span class="practice-elapsed" title="First keystroke to submit">@shown</span>
            }
        }

        @*
            aria-pressed rather than colour alone, so the state is announced rather than implied. The
            label changes with the state for the same reason.
        *@
        <button type="button"
                class="practice-star @(Model.IsSaved ? "is-saved" : "")"
                data-practice-star
                aria-pressed="@(Model.IsSaved ? "true" : "false")"
                title="@(Model.IsSaved ? "Saved — click to unsave" : "Save this question")"
                aria-label="@(Model.IsSaved ? "Saved — click to unsave" : "Save this question")">@(Model.IsSaved ? "★" : "☆")</button>
    </div>

    <p class="practice-prompt">@Model.Prompt</p>

    @if (answered && feedback is not null)
    {
        <details class="practice-answered" data-practice-feedback open="@(expanded ? "open" : null)">
            <summary class="practice-answered-summary">
                <span class="practice-answered-summary-open">Hide feedback</span>
                <span class="practice-answered-summary-closed">Show feedback</span>
            </summary>

            @if (!attempts.Any())
            {
                <div class="practice-answer-given">
                    <p class="practice-answer-label">Your answer</p>
                    <p class="practice-answer-text">@Model.UserAnswer</p>
                </div>
            }
            else
            {
                @*
                    Attempts side by side, oldest first, with the current one last and marked — reading
                    left to right is reading the progression. This is the one thing the cards could not
                    show before: the attempts were stacked in a disclosure, so comparing what changed
                    between a 2 and a 4 meant scrolling between them.

                    A horizontal scroll on a narrow screen rather than stacking, deliberately: stacking
                    is what this replaces, so collapsing back to it on a phone would give the same
                    non-comparison under a new name. Capped at AttemptHistory.Keep + 1 columns.
                *@
                <div class="practice-compare">
                    <p class="practice-answer-label">Your attempts</p>
                    <div class="practice-compare-track">
                        @{
                            // attempts is newest-first; reversed so the columns read oldest to newest.
                            var ordered = attempts.AsEnumerable().Reverse().ToList();
                            var attemptNumber = 0;
                        }
                        @foreach (var a in ordered)
                        {
                            attemptNumber++;
                            var tone = a.Score >= 4 ? "high" : a.Score == 3 ? "mid" : "low";
                            <div class="practice-compare-col">
                                <p class="practice-compare-head">
                                    <span class="practice-compare-n">Attempt @attemptNumber</span>
                                    <span class="practice-score practice-score--@tone">@a.Score<span class="practice-score-max">/@AnswerFeedback.MaxScore</span></span>
                                </p>
                                <p class="practice-attempt-when">@a.AnsweredAt.ToString("d MMM yyyy")</p>
                                <p class="practice-answer-text">@a.Answer</p>
                            </div>
                        }

                        <div class="practice-compare-col practice-compare-col--current">
                            <p class="practice-compare-head">
                                <span class="practice-compare-n">Attempt @(attemptNumber + 1) &middot; latest</span>
                                <span class="practice-score practice-score--@scoreTone">@score<span class="practice-score-max">/@AnswerFeedback.MaxScore</span></span>
                            </p>
                            <p class="practice-attempt-when">
                                @(Model.AnsweredAt?.ToString("d MMM yyyy"))
                                @if (Model.AnsweredInSeconds is { } secs)
                                {
                                    <text>&middot; @(secs < 60 ? $"{secs}s" : $"{secs / 60}m {secs % 60:00}s")</text>
                                }
                            </p>
                            <p class="practice-answer-text">@Model.UserAnswer</p>
                        </div>
                    </div>
                </div>
            }

            @if (feedback.Strengths.Any())
            {
                <div class="practice-feedback-block">
                    <p class="practice-answer-label">What worked</p>
                    <ul class="practice-feedback-list">
                        @foreach (var s in feedback.Strengths) { <li>@s</li> }
                    </ul>
                </div>
            }

            @if (improvements.Any())
            {
                <div class="practice-feedback-block">
                    <p class="practice-answer-label">@(improvements.Count == 1 ? "One thing to change" : "Two things to change")</p>
                    <ul class="practice-feedback-list">
                        @foreach (var i in improvements) { <li>@i</li> }
                    </ul>
                </div>
            }

            @if (feedback.MissingPoints.Any())
            {
                <div class="practice-feedback-block">
                    <p class="practice-answer-label">What you left out</p>
                    <ul class="practice-feedback-list">
                        @foreach (var m in feedback.MissingPoints) { <li>@m</li> }
                    </ul>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(feedback.RevisedOpening))
            {
                <div class="practice-feedback-block">
                    <p class="practice-answer-label">A stronger opening</p>
                    <blockquote class="practice-revised">@feedback.RevisedOpening</blockquote>
                </div>
            }

            <button type="button" class="btn btn-outline-primary btn-sm mt-2" data-practice-retry>Retry this question</button>
        </details>
    }

    @*
        One form per card, always in the markup. When the question is answered it starts hidden and
        "Retry this question" reveals it, which is why retrying needs no round trip: the previous attempt
        only rotates into history when the next one is submitted.
    *@
    <form class="practice-answer-form" data-practice-answer-form hidden="@(answered ? "hidden" : null)">
        <label class="practice-answer-label" for="practice-answer-@Model.Id">
            @(answered ? "Try it again" : "Your answer")
        </label>
        <textarea id="practice-answer-@Model.Id" name="answer" class="practice-answer-input" rows="5"
                  maxlength="@PracticeAnswerService.MaxAnswerChars"
                  placeholder="Answer as you would out loud…"></textarea>

        @if (Model.Category == QuestionCategory.Behavioral)
        {
            @*
                Collapsed, not expanded: a scaffold on every behavioural card is noise to someone who
                already structures their answers this way.
            *@
            <details class="practice-star">
                <summary>Structure it with STAR</summary>
                <ul class="practice-star-list">
                    <li><strong>Situation</strong> — where you were and what was going on.</li>
                    <li><strong>Task</strong> — what you were responsible for.</li>
                    <li><strong>Action</strong> — what you actually did, in the first person.</li>
                    <li><strong>Result</strong> — how it turned out, with a number or a consequence.</li>
                </ul>
            </details>
        }

        <div class="practice-answer-actions">
            <button type="submit" class="btn btn-primary btn-sm" data-practice-submit disabled>
                <span data-practice-submit-label>Get feedback</span>
            </button>
            <span class="form-hint mt-0" data-practice-counter>
                0 / @PracticeAnswerService.MinAnswerChars characters
            </span>
        </div>

        <div class="match-error-banner mt-2" data-practice-answer-error hidden></div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ModelHint))
    {
        @*
            Opens with the feedback, not merely because the question was answered. Once the answered
            body folds away, a hint hanging open underneath a collapsed card contradicts it.
        *@
        <details class="practice-hint" open="@(expanded ? "open" : null)">
            <summary>What a strong answer covers</summary>
            <p class="practice-hint-body">@Model.ModelHint</p>
        </details>
    }
</div>
