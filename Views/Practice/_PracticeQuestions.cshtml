@model List<InternTrackAI.Models.PracticeQuestion>
@using InternTrackAI.Models.Enums
@*
    One question card per row. Rendered both on first load and by /Practice/GenerateMore, so the
    markup for a card exists exactly once — the client appends this HTML rather than rebuilding it.
*@
@foreach (var q in Model)
{
    <div class="practice-card" data-question-id="@q.Id">
        <div class="practice-card-meta">
            <span class="practice-badge practice-badge--@q.Difficulty.ToString().ToLowerInvariant()">@q.Difficulty</span>
            <span class="practice-badge practice-badge--category">@QuestionCategories.Display(q.Category)</span>
            @if (!string.IsNullOrWhiteSpace(q.Topic))
            {
                <span class="practice-topic">@q.Topic</span>
            }
        </div>
        <p class="practice-prompt">@q.Prompt</p>
        @if (!string.IsNullOrWhiteSpace(q.ModelHint))
        {
            <details class="practice-hint">
                <summary>What a strong answer covers</summary>
                <p class="practice-hint-body">@q.ModelHint</p>
            </details>
        }
    </div>
}
