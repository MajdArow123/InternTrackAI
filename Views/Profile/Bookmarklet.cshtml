@model InternTrackAI.Models.ViewModels.BookmarkletViewModel
@using InternTrackAI.Models.ViewModels

@{
    ViewData["Title"] = "Save to InternTrackAI bookmarklet";
}

<div class="container py-4 container-narrow">

    <!-- Breadcrumb -->
    <nav class="breadcrumb-nav" aria-label="breadcrumb">
        <ol class="breadcrumb-list">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li><a asp-controller="Profile" asp-action="Index">Profile</a></li>
            <li>Bookmarklet</li>
        </ol>
    </nav>

    <div class="page-header">
        <div>
            <h1>Save from anywhere</h1>
            <p class="sub">Add a job posting to your tracker from any site with one click</p>
        </div>
        <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>

    <!-- The button -->
    <div class="form-card mb-3 bm-hero">
        <p class="form-section-title mb-1">Drag this button to your bookmarks bar</p>
        <p class="form-hint">It becomes a bookmark named &ldquo;@BookmarkletViewModel.Label&rdquo;. Nothing to install, and it works in every desktop browser.</p>

        <div class="bm-drop-zone">
            <a href="@Model.Code" class="btn btn-primary bookmarklet-btn" id="bookmarkletBtn"
               draggable="true" title="Drag me to your bookmarks bar" data-label="@BookmarkletViewModel.Label">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                @BookmarkletViewModel.Label
            </a>
            <span class="bm-drop-hint" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg>
                drag up to the bookmarks bar
            </span>
        </div>

        <p class="form-hint mb-0 bm-bar-tip">
            Can&rsquo;t see a bookmarks bar? Press <span class="kbd">&#8984;</span><span class="kbd">&#8679;</span><span class="kbd">B</span> on Mac
            or <span class="kbd">Ctrl</span><span class="kbd">Shift</span><span class="kbd">B</span> on Windows to show it.
        </p>
    </div>

    <!-- Three steps -->
    <div class="form-card mb-3">
        <p class="form-section-title">How it works</p>
        <ol class="bm-steps">
            <li class="bm-step">
                <span class="onboarding-step-icon">1</span>
                <div>
                    <div class="bm-step-title">Drag the button to your bookmarks bar</div>
                    <div class="bm-step-text">Or copy the code below and paste it as the URL of a new bookmark.</div>
                </div>
            </li>
            <li class="bm-step">
                <span class="onboarding-step-icon">2</span>
                <div>
                    <div class="bm-step-title">Open a job posting</div>
                    <div class="bm-step-text">Any page with a public URL &mdash; LinkedIn, Indeed, Glassdoor, Lever, Greenhouse, or a company careers page.</div>
                </div>
            </li>
            <li class="bm-step">
                <span class="onboarding-step-icon">3</span>
                <div>
                    <div class="bm-step-title">Click &ldquo;@BookmarkletViewModel.Label&rdquo;</div>
                    <div class="bm-step-text">A new tab opens with the Add Application form pre-filled with company, role, location, and salary. Review it, then save. Your job-board tab stays where it was.</div>
                </div>
            </li>
        </ol>
    </div>

    <!-- Copy fallback -->
    <div class="form-card mb-3">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
            <div>
                <p class="form-section-title mb-1">Prefer to paste it?</p>
                <p class="form-hint mb-0">Dragging is awkward in Safari on Mac. Copy the code, add a new bookmark, and paste this as its address.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="copyBookmarkletBtn">Copy bookmarklet code</button>
                <span class="save-indicator" id="copyBookmarkletIndicator">Copied &#10003;</span>
            </div>
        </div>
        <textarea class="form-control bm-code" id="bookmarkletCode" readonly rows="3" spellcheck="false"
                  aria-label="Bookmarklet code">@Model.Code</textarea>
        <p class="form-hint mt-2 mb-0">
            Safari: Bookmarks &rsaquo; Add Bookmark, then Bookmarks &rsaquo; Edit Bookmarks, and replace the address with the code above.
        </p>
    </div>

    <!-- Where it works -->
    <div class="form-card mb-3 bm-notes">
        <p class="form-section-title">Where it works</p>
        <p class="bm-note">
            Anywhere with a public URL: LinkedIn, Indeed, Glassdoor, company career pages, and most job boards.
            The bookmarklet only sends the page&rsquo;s address and title to <code>@Model.CaptureUrl</code>. InternTrackAI reads the posting from its own server and never looks at your other tabs.
        </p>
        <p class="bm-note mb-0">
            Postings behind a login (some LinkedIn views, internal portals) can&rsquo;t be read automatically. When that happens you still land on the form with the link and title filled in &mdash; just add the rest by hand.
        </p>
    </div>

</div>

@section Scripts {
    <script src="~/js/bookmarklet.js" asp-append-version="true"></script>
}
