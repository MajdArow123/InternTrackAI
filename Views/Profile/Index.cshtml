@model InternTrackAI.Models.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Profile";
}

<div class="container py-4 container-narrow">

    <!-- Breadcrumb -->
    <nav class="breadcrumb-nav" aria-label="breadcrumb">
        <ol class="breadcrumb-list">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li>Profile</li>
        </ol>
    </nav>

    <div class="page-header">
        <div>
            <h1>Profile</h1>
            <p class="sub">Your career information, documents, and AI tools</p>
        </div>
        <a asp-area="Identity" asp-page="/Account/Manage/Index"
           class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
            </svg>
            Account settings
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3 profile-success-alert" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="match-error-banner mb-3">@TempData["Error"]</div>
    }
    @if (TempData["ScoreError"] != null)
    {
        <div class="match-error-banner mb-3">@TempData["ScoreError"]</div>
    }
    @if (TempData["AutoFillAdded"] is string autoFillAdded)
    {
        @* Skills/roles the review just added; profile.js flashes their chips once on load. *@
        <input type="hidden" id="autoFillAdded" value="@autoFillAdded" />
    }

    @if (Model.PendingParse is { } pendingParse)
    {
        @* A parse the user walked away from instead of confirming. Without this the draft is stranded:
           the profile looks untouched (correctly — nothing was written) with no way back to the review. *@
        <div class="form-card mb-3" id="pendingParseCard">
            <p class="form-section-title form-section-title--sm mb-1">Resume analysis waiting for you</p>
            <p class="form-hint mb-3">We read your resume but haven't saved anything yet. Review what we found to add it to your profile.</p>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <a asp-action="ReviewResume" asp-route-id="@pendingParse.Id" class="btn btn-primary">Review what we found</a>
                <form asp-action="DiscardResumeReview" method="post" class="d-inline"
                      data-confirm-title="Discard this analysis?" data-confirm="Your profile stays exactly as it is." data-confirm-ok="Discard">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="draftId" value="@pendingParse.Id" />
                    <button type="submit" class="btn btn-outline-secondary">Discard</button>
                </form>
            </div>
        </div>
    }

    <partial name="_IdentityCard" model="Model" />
    @* The resume feeds the AI tools and the auto-filled profile fields below, so it comes first. *@
    <partial name="_Resume" model="Model" />
    <partial name="_Bookmarklet" />
    <partial name="_ConnectedAccounts" model="Model" />
    <partial name="_Reminders" model="Model" />
    <partial name="_Calendar" model="Model" />
    <partial name="_BasicInfo" model="Model" />
    <partial name="_SkillsRoles" model="Model" />
    <partial name="_GitHubProjects" model="Model" />

</div>

@section Scripts {
    <script src="~/js/tag-input.js" asp-append-version="true"></script>
    <script src="~/js/profile.js" asp-append-version="true"></script>
    <script src="~/js/bullet-rewriter.js" asp-append-version="true"></script>
}
