@model InternTrackAI.Models.ViewModels.PublicProfileViewModel
@{
    ViewData["Title"] = Model.DisplayName;
    Layout = "_Layout";

    var initials = string.Concat(Model.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2).Select(w => char.ToUpperInvariant(w[0])));
}

<div class="container py-4 container-narrow public-profile">

    <div class="form-card mb-3 text-center public-hero">
        @if (Model.PhotoPath != null)
        {
            <img src="@Model.PhotoPath" class="profile-avatar profile-avatar--lg mb-3" alt="@Model.DisplayName" />
        }
        else
        {
            <div class="profile-avatar-placeholder profile-avatar--lg mb-3 mx-auto">@initials</div>
        }
        <h1 class="public-name mb-1">@Model.DisplayName</h1>
        <p class="form-hint mt-0 mb-0">Career portfolio &middot; InternTrackAI</p>
    </div>

    @if (Model.TargetRoles.Any())
    {
        <div class="form-card mb-3">
            <p class="form-section-title">Target roles</p>
            <div class="tag-cloud">
                @foreach (var role in Model.TargetRoles)
                {
                    <span class="tag-item">@role</span>
                }
            </div>
        </div>
    }

    @if (Model.Skills.Any())
    {
        <div class="form-card mb-3">
            <p class="form-section-title">Skills</p>
            <div class="tag-cloud">
                @foreach (var skill in Model.Skills)
                {
                    <span class="tag-item">@skill</span>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.GitHubUsername) && Model.GitHubRepos != null && Model.GitHubRepos.Any())
    {
        <div class="form-card mb-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <p class="form-section-title mb-0">Projects</p>
                <a href="https://github.com/@Model.GitHubUsername" target="_blank" rel="noopener"
                   class="form-hint mt-0">@@@Model.GitHubUsername on GitHub &rarr;</a>
            </div>
            <div class="doc-list">
                @foreach (var repo in Model.GitHubRepos)
                {
                    <a class="doc-row doc-row-link" href="@repo.Url" target="_blank" rel="noopener">
                        <div class="doc-info">
                            <div class="doc-filename">@repo.Name</div>
                            <div class="doc-meta">
                                @(string.IsNullOrWhiteSpace(repo.Description) ? "No description" : repo.Description)
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(repo.Language))
                        {
                            <span class="active-label">@repo.Language</span>
                        }
                        <span class="doc-stars">&#9733; @repo.Stars</span>
                    </a>
                }
            </div>
        </div>
    }

    @if (Model.TotalApplications > 0)
    {
        <div class="form-card mb-3">
            <p class="form-section-title">Application stats</p>
            <div class="profile-stat-strip profile-stat-strip--flat">
                <div class="profile-stat">
                    <span class="profile-stat-num">@Model.TotalApplications</span>
                    <span class="profile-stat-label">Applications</span>
                </div>
                <div class="profile-stat">
                    <span class="profile-stat-num text-success">@Model.SuccessRate<span class="profile-stat-unit">%</span></span>
                    <span class="profile-stat-label">Success rate</span>
                </div>
            </div>
        </div>
    }

</div>
