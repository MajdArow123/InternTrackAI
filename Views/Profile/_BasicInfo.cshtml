@model InternTrackAI.Models.ViewModels.ProfileViewModel
@{
    var clock       = await Clocks.GetAsync();
    var currentZone = clock.ZoneId;
}
    <!-- ── Personal Info ── -->
    <div class="form-card mb-3">
        <p class="form-section-title">Basic info</p>
        <p class="form-hint mb-3">Used across the app.</p>
        <form id="infoForm">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label" for="fullNameInput">Full name</label>
                    <div class="field-skeleton-wrap" id="fullNameWrap">
                        <input name="fullName" id="fullNameInput" class="form-control" placeholder="e.g. Alex Johnson"
                               value="@Model.Profile.FullName" />
                    </div>
                </div>
                <div class="col-sm-6">
                    <label class="form-label">Display name <span class="text-muted fw-normal">(shown in navbar)</span></label>
                    @if (Model.IsDemoAccount)
                    {
                        <input name="displayName" id="displayNameInput" class="form-control" value="@Model.Profile.DisplayName"
                               disabled aria-describedby="displayNameDemoHint" />
                        <p class="form-hint mb-0 mt-1" id="displayNameDemoHint" data-demo-guard="displayName">@ConfiguredAccounts.DemoUnavailableMessage</p>
                    }
                    else
                    {
                        <input name="displayName" id="displayNameInput" class="form-control" placeholder="e.g. Alex"
                               value="@Model.Profile.DisplayName" />
                    }
                </div>
                <div class="col-sm-6">
                    <label class="form-label">Country</label>
                    <input name="country" class="form-control" placeholder="e.g. United States"
                           value="@Model.Profile.Country" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label">Email <span class="text-muted fw-normal">(from account)</span></label>
                    <input class="form-control" value="@Model.Email" disabled />
                </div>
                <div class="col-sm-6">
                    <label class="form-label">Phone number <span class="text-muted fw-normal">(optional)</span></label>
                    <input name="phoneNumber" class="form-control" placeholder="e.g. +1 555 123 4567"
                           value="@Model.Profile.PhoneNumber" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label">GitHub username <span class="text-muted fw-normal">(optional)</span></label>
                    <input name="githubUsername" class="form-control" placeholder="e.g. octocat"
                           value="@Model.Profile.GitHubUsername" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label" for="timeZoneSelect">Time zone</label>
                    <select name="timeZoneId" id="timeZoneSelect" class="form-select" aria-describedby="timeZoneHint">
                        @foreach (var group in TimeZones.Groups(clock.NowUtc, currentZone))
                        {
                            <optgroup label="@group.Region">
                                @foreach (var z in group.Zones)
                                {
                                    <option value="@z.Id" selected="@(z.Id == currentZone)">@z.Label</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <div class="form-hint mt-1" id="timeZoneHint">Interview times, notes and reminders are shown in this zone. Now: <span id="timeZoneNow">@clock.NowLocal.ToString(UserClock.TimeFormat, System.Globalization.CultureInfo.InvariantCulture)</span></div>
                </div>
            </div>
            <div class="mt-3 d-flex align-items-center">
                <button type="submit" class="btn btn-primary px-4" id="saveInfoBtn">Save info</button>
                <span class="save-indicator" id="infoSaveIndicator">Saved &#10003;</span>
            </div>
        </form>
    </div>
