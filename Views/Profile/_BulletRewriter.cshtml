@model InternTrackAI.Models.ViewModels.ProfileViewModel
@* "Rewrite a bullet" (wwwroot/js/bullet-rewriter.js → POST /Profile/RewriteBullet). Paste-only: stored resume text
   has no line breaks, so bullets can't be picked from it reliably. Every model string is rendered with textContent. *@
<section class="rewrite-section mt-3 pt-3" id="bulletRewriter" aria-labelledby="rewriteTitle">
    <p class="form-section-title form-section-title--sm mb-1" id="rewriteTitle">Rewrite a bullet</p>
    <p class="form-hint mt-0 mb-3">Paste one bullet from your resume and pick a job. You get 2–3 rewrites aimed at that posting, using only the facts already in your bullet.</p>

    @if (Model.RewriteApplications.Count == 0)
    {
        <div class="rewrite-empty" id="rewriteEmpty">
            <p class="mb-1"><strong>None of your applications has a job description yet.</strong></p>
            <p class="form-hint mt-0 mb-0">
                The rewrite aims at a specific posting, so it needs one.
                <a asp-controller="JobApplications" asp-action="Create">Add an application</a> with its job description,
                or open one in <a asp-controller="JobApplications" asp-action="Index">Applications</a> and paste the posting into it.
            </p>
        </div>
    }
    else
    {
        <form class="rewrite-form" id="rewriteForm" novalidate>
            <div>
                <div class="d-flex align-items-center justify-content-between">
                    <label class="form-label" for="rewriteBullet">Bullet</label>
                    <span class="word-count" id="rewriteCount" aria-live="off">0 / 400</span>
                </div>
                <textarea class="form-control rewrite-textarea" id="rewriteBullet" rows="3" maxlength="400" spellcheck="true"
                          placeholder="e.g. Worked on the backend API for a team project" aria-describedby="rewriteBulletHint"></textarea>
                <p class="form-hint mt-1 mb-0" id="rewriteBulletHint">One bullet at a time. Ctrl+Enter to rewrite.</p>
            </div>
            <div>
                <label class="form-label" for="rewriteApp">Aim it at</label>
                <select class="form-select" id="rewriteApp">
                    @foreach (var a in Model.RewriteApplications)
                    {
                        <option value="@a.Id">@a.CompanyName — @a.RoleTitle</option>
                    }
                </select>
            </div>
            <div>
                <button type="submit" class="btn btn-primary analyze-btn" id="rewriteBtn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
                    </svg>
                    <span id="rewriteBtnLabel">Rewrite</span>
                </button>
            </div>
        </form>

        <p class="visually-hidden" id="rewriteStatus" aria-live="polite"></p>

        <div class="rewrite-error mt-3" id="rewriteError" role="alert" hidden>
            <p class="match-error-banner mb-0"><span id="rewriteErrorText"></span> <a id="rewriteEditLink" hidden>Edit the application</a></p>
            <button type="button" class="btn btn-sm btn-outline-primary" id="rewriteRetry">Retry</button>
        </div>

        <div class="rewrite-results mt-3" id="rewriteResults" hidden>
            <p class="form-section-title form-section-title--sm mb-2" id="rewriteResultsTitle" tabindex="-1">Rewrites</p>
            <p class="cl-info-banner mb-2" id="rewriteDemoNote" hidden></p>
            <p class="rewrite-discarded mb-2" id="rewriteDiscardedNote" hidden></p>
            <p class="form-hint mt-0 mb-2" id="rewritePlaceholderHint" hidden>Replace the bracketed values with your real numbers.</p>
            <ol class="rewrite-list" id="rewriteList"></ol>
        </div>
    }
</section>
