@model InternTrackAI.Models.ViewModels.ProfileViewModel
@{ var clock = await Clocks.GetAsync(); }
    <!-- ── Cover Letters ── -->
    <div class="form-card mb-3">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <p class="form-section-title mb-0">Cover letters</p>
            <span class="form-hint mt-0">@Model.CoverLetters.Count version@(Model.CoverLetters.Count == 1 ? "" : "s")</span>
        </div>

        @if (Model.CoverLetters.Any())
        {
            <div class="doc-list mb-3">
                @foreach (var cl in Model.CoverLetters)
                {
                    <div class="doc-row @(cl.IsActive ? "doc-active" : "")">
                        <span class="doc-version-badge">v@(cl.VersionNumber)</span>
                        <div class="doc-info">
                            <div class="doc-filename">@cl.OriginalFileName</div>
                            <div class="doc-meta">
                                @clock.LocalDate(cl.UploadedAt) &middot;
                                @((cl.FileSize / 1024.0).ToString("F0")) KB
                            </div>
                        </div>
                        <div class="doc-actions">
                        @if (cl.IsActive)
                        {
                            <span class="active-label">Active</span>
                        }
                        else
                        {
                            <form asp-action="SetActiveCoverLetter" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@cl.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary doc-btn">Set active</button>
                            </form>
                        }
                        <a asp-action="DownloadCoverLetter" asp-route-id="@cl.Id"
                           class="btn btn-sm btn-outline-secondary doc-btn">Download</a>
                        <form asp-action="DeleteCoverLetter" method="post" class="d-inline"
                              data-confirm-title="Delete cover letter v@(cl.VersionNumber)?" data-confirm="This permanently removes the file. This cannot be undone.">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@cl.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger doc-btn">Delete</button>
                        </form>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="doc-empty mb-3">
                <p class="doc-empty-title">No cover letters yet</p>
                <p class="doc-empty-text">Upload a PDF, or generate one with the Cover Letter tool.</p>
            </div>
        }

        <form asp-action="UploadCoverLetter" method="post" enctype="multipart/form-data" class="upload-form">
            @Html.AntiForgeryToken()
            <label class="upload-zone upload-zone--compact" for="coverLetterInput">
                <input type="file" name="coverLetter" id="coverLetterInput" accept=".pdf" class="upload-zone-input" />
                <span class="upload-zone-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                </span>
                <span class="upload-zone-title">Drop a PDF here or <span class="upload-zone-link">browse</span></span>
                <span class="upload-zone-hint">PDF only &middot; max 5 MB</span>
                <span class="upload-zone-file" hidden></span>
            </label>
            <div class="d-flex align-items-center gap-2 mt-2">
                <button type="submit" class="btn btn-primary">Upload new cover letter</button>
            </div>
        </form>
    </div>
