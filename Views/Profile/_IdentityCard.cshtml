@model InternTrackAI.Models.ViewModels.ProfileViewModel
@{ var clock = await Clocks.GetAsync(); }
@using InternTrackAI.Helpers
@{
    var initials  = ProfileDisplay.Initials(Model.Profile.FullName, Model.Email);
    var photoPath = ProfileDisplay.PhotoUrl(Model.Profile.PhotoFileName, Model.Profile.PhotoVersion);
    var hasPhoto  = photoPath != null;
}
    <!-- ── Identity card: avatar (the circle is the photo control), name, stats ── -->
    <div class="form-card mb-3 profile-hero">
        <div class="profile-photo-row">
            <div class="profile-avatar-wrap" id="avatarWrap" data-has-photo="@(hasPhoto ? "true" : "false")">
                <button type="button" class="profile-avatar-btn" id="avatarBtn" aria-label="Change profile photo" title="Change profile photo">
                    <img src="@(photoPath ?? "")" class="profile-avatar" id="avatarImg" alt="Profile photo" hidden="@(!hasPhoto)" />
                    <span class="profile-avatar-placeholder" id="avatarPlaceholder" aria-hidden="true" hidden="@hasPhoto">@initials</span>
                    <span class="profile-avatar-overlay" aria-hidden="true">
                        <svg class="profile-avatar-overlay-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                        <span class="spinner-border spinner-border-sm profile-avatar-spinner" role="status" aria-hidden="true"></span>
                        <span class="profile-avatar-overlay-label">Change</span>
                    </span>
                </button>
                <input type="file" id="photoInput" accept="image/*" class="visually-hidden" tabindex="-1" aria-hidden="true" />
                <form id="photoForm" hidden>@Html.AntiForgeryToken()</form>
                <button type="button" class="profile-photo-remove" id="removePhotoBtn" hidden="@(!hasPhoto)">Remove photo</button>
            </div>
            <div class="profile-identity">
                <p class="profile-photo-name mb-0">@(Model.Profile.FullName ?? "Your name")</p>
                <p class="profile-photo-email">@Model.Email</p>
            </div>
        </div>

        <div class="profile-stat-strip">
            <div class="profile-stat">
                <span class="profile-stat-num">@Model.TotalApplications</span>
                <span class="profile-stat-label">Total</span>
            </div>
            @foreach (var entry in Model.StatusCounts)
            {
                var dotClass = entry.Key switch
                {
                    InternTrackAI.Models.Enums.ApplicationStatus.Saved      => "dot-saved",
                    InternTrackAI.Models.Enums.ApplicationStatus.Applied    => "dot-applied",
                    InternTrackAI.Models.Enums.ApplicationStatus.Interview  => "dot-interview",
                    InternTrackAI.Models.Enums.ApplicationStatus.Offer      => "dot-offer",
                    InternTrackAI.Models.Enums.ApplicationStatus.Rejected   => "dot-rejected",
                    _ => ""
                };
                <div class="profile-stat">
                    <span class="profile-stat-num">@entry.Value</span>
                    <span class="profile-stat-label"><span class="profile-stat-dot @dotClass"></span>@entry.Key</span>
                </div>
            }
            <div class="profile-stat">
                <span class="profile-stat-num text-success">@Model.SuccessRate<span class="profile-stat-unit">%</span></span>
                <span class="profile-stat-label">Success rate</span>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    @if (Model.TotalApplications > 0)
    {
        <div class="quick-stats-row">
            <div class="quick-stat-card">
                <div class="quick-stat-label">This month</div>
                <div class="quick-stat-value">@Model.ApplicationsThisMonth</div>
                <div class="quick-stat-sub">application@(Model.ApplicationsThisMonth == 1 ? "" : "s") applied</div>
            </div>

            <div class="quick-stat-card">
                <div class="quick-stat-label">Upcoming deadlines</div>
                @if (Model.UpcomingDeadlines7Days.Any())
                {
                    <div class="quick-stat-value">@Model.UpcomingDeadlines7Days.Count</div>
                    <div class="quick-deadline-list">
                        @foreach (var app in Model.UpcomingDeadlines7Days.Take(3))
                        {
                            var daysLeft = clock.DaysUntil(app.Deadline!.Value);
                            var urgent   = daysLeft <= 2;
                            <div class="quick-deadline-item">
                                <span class="@(urgent ? "quick-deadline-urgent" : "")">@app.CompanyName</span>
                                <span class="quick-deadline-date">@(daysLeft == 0 ? "Today" : daysLeft == 1 ? "Tomorrow" : $"{daysLeft}d")</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="quick-stat-value">0</div>
                    <div class="quick-stat-sub">in the next 7 days</div>
                }
            </div>

            <div class="quick-stat-card">
                <div class="quick-stat-label">Recent matches</div>
                @if (Model.RecentMatchedApps.Any())
                {
                    <div class="quick-stat-value">@Model.RecentMatchedApps.Count</div>
                    <div class="quick-match-list">
                        @foreach (var app in Model.RecentMatchedApps)
                        {
                            var sc       = app.MatchScore!.Value;
                            var tierCls  = sc >= 80 ? "match-tier-5" : sc >= 60 ? "match-tier-4" : sc >= 40 ? "match-tier-3" : sc >= 20 ? "match-tier-2" : "match-tier-1";
                            <div class="quick-match-item">
                                <span class="text-truncate">@app.CompanyName</span>
                                <span class="match-rec-badge match-rec-badge--sm @tierCls">@sc%</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="quick-stat-value">—</div>
                    <div class="quick-stat-sub">no resume analyses yet</div>
                }
            </div>
        </div>
    }
