@model InternTrackAI.Models.ViewModels.ProfileViewModel
@using InternTrackAI.Services
    <!-- ── Reminders ── -->
    <div class="form-card mb-3">
        <p class="form-section-title mb-1">Reminders</p>
        <p class="form-hint mb-3">How long to wait after applying (or after your last contact) before an application shows up as <em>follow up</em> on the dashboard, board, and list.</p>
        <form id="reminderForm" class="d-flex align-items-end gap-2 flex-wrap">
            <div>
                <label class="form-label" for="followUpAfterDaysInput">Follow up after</label>
                <div class="d-flex align-items-center gap-2">
                    <input type="number" name="followUpAfterDays" id="followUpAfterDaysInput" class="form-control reminder-days-input"
                           min="@ReminderService.MinFollowUpAfterDays" max="@ReminderService.MaxFollowUpAfterDays" step="1" required
                           value="@ReminderService.Normalize(Model.Profile.FollowUpAfterDays)" aria-describedby="followUpDaysHint" />
                    <span class="text-muted">days</span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary" id="saveReminderBtn">Save</button>
            <span class="save-indicator" id="reminderSaveIndicator">Saved &#10003;</span>
        </form>
        <p class="form-hint mt-2 mb-0" id="followUpDaysHint">Between @ReminderService.MinFollowUpAfterDays and @ReminderService.MaxFollowUpAfterDays days. Default is @ReminderService.DefaultFollowUpAfterDays.</p>
    </div>
