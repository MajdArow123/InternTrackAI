@model InternTrackAI.Models.ViewModels.ProfileViewModel
@using System.Globalization
@{
    var clock = await Clocks.GetAsync();

    // Score ring vars (the AI score result renders inside this card, under the AI buttons)
    const double Circ = 339.29;
    int scoreDashOff = (int)Circ;
    string scoreColor = "maybe";
    if (Model.ScoreResult?.Success == true)
    {
        scoreDashOff = (int)(Circ * (1.0 - Model.ScoreResult.Score / 100.0));
        scoreColor   = Model.ScoreResult.Score >= 70 ? "apply" : Model.ScoreResult.Score >= 40 ? "maybe" : "noapply";
    }
    string CircStr = Circ.ToString("F2", CultureInfo.InvariantCulture);
}
    <!-- ── Resume: versions, drop zone, AI analyze + AI score (one card) ── -->
    <div class="form-card mb-3 resume-hero-card @(Model.Resumes.Any() ? "has-resume" : "")" id="resumeHeroCard">
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <p class="form-section-title mb-0">Resume</p>
            <span class="form-hint mt-0">@Model.Resumes.Count version@(Model.Resumes.Count == 1 ? "" : "s")</span>
        </div>

        @if (Model.Resumes.Any())
        {
            <form id="resumeRenameForm" hidden>@Html.AntiForgeryToken()</form>
            <div class="doc-list mb-3" data-tour="resume-versions">
                @foreach (var r in Model.Resumes)
                {
                    <div class="doc-row @(r.IsActive ? "doc-active" : "")">
                        <span class="doc-version-badge">v@(r.VersionNumber)</span>
                        <div class="doc-info">
                            <div class="doc-filename doc-label-row" data-resume-id="@r.Id">
                                <span class="doc-label" data-resume-label>@r.DisplayName</span>
                                <button type="button" class="doc-label-edit" data-resume-rename aria-label="Rename resume v@(r.VersionNumber)" title="Rename">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                                </button>
                                <input type="text" class="form-control form-control-sm doc-label-input" maxlength="60" value="@(r.Label ?? "")" placeholder="@System.IO.Path.GetFileNameWithoutExtension(r.OriginalFileName)" aria-label="Resume name" hidden />
                            </div>
                            <div class="doc-meta">
                                @r.OriginalFileName &middot;
                                @clock.LocalDate(r.UploadedAt) &middot;
                                @((r.FileSize / 1024.0).ToString("F0")) KB
                                @if (Model.ResumeStats.TryGetValue(r.Id, out var stat))
                                {
                                    <span class="doc-stat" data-resume-stat="@r.Id">&middot; @stat.Sent sent @if (stat.Sent > 0) {<text>&middot; @stat.ResponseRatePercent% response rate</text>}</span>
                                }
                            </div>
                        </div>
                        <div class="doc-actions">
                        @if (r.IsActive)
                        {
                            <span class="active-label">Active</span>
                        }
                        else
                        {
                            <form asp-action="SetActiveResume" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary doc-btn">Set active</button>
                            </form>
                        }
                        <a asp-action="DownloadResume" asp-route-id="@r.Id"
                           class="btn btn-sm btn-outline-secondary doc-btn">Download</a>
                        <form asp-action="DeleteResume" method="post" class="d-inline"
                              data-confirm-title="Delete resume v@(r.VersionNumber)?" data-confirm="This permanently removes the file. This cannot be undone.">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger doc-btn">Delete</button>
                        </form>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="doc-empty mb-3">
                <p class="doc-empty-title">No resume yet</p>
                <p class="doc-empty-text">Upload a PDF below, then let AI fill in your name, skills, and target roles.</p>
            </div>
        }

        <form asp-action="UploadResume" method="post" enctype="multipart/form-data" class="upload-form">
            @Html.AntiForgeryToken()
            <label class="upload-zone" for="resumeInput">
                <input type="file" name="resume" id="resumeInput" accept=".pdf" class="upload-zone-input" />
                <span class="upload-zone-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                </span>
                <span class="upload-zone-title">Drop a PDF here or <span class="upload-zone-link">browse</span></span>
                <span class="upload-zone-hint">PDF only &middot; max 5 MB</span>
                <span class="upload-zone-file" hidden></span>
            </label>
            <div class="d-flex align-items-center gap-2 mt-2">
                <button type="submit" class="btn btn-primary">Upload new resume</button>
            </div>
        </form>

        @if (Model.Resumes.Any(r => r.IsActive))
        {
            <div class="mt-3 pt-3 analyze-row" id="resumeAiRow">
                <div class="resume-ai-buttons">
                    <button type="button" class="btn btn-primary analyze-btn" id="analyzeBtn">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2l1.8 5.5L19 9l-5.2 1.5L12 16l-1.8-5.5L5 9l5.2-1.5z"/>
                        </svg>
                        <span id="analyzeBtnLabel">Analyze with AI</span>
                    </button>
                    <form asp-action="ScoreResume" method="post" class="d-inline" id="scoreForm">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary analyze-btn" id="scoreBtn">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                            </svg>
                            Score my resume
                        </button>
                    </form>
                </div>
                <p class="form-hint mt-2 mb-0 w-100 resume-ai-hint">
                    <strong>Analyze</strong> fills in your name, skills, and target roles from the active resume (adds, never removes).
                    <strong>Score</strong> rates it with strengths and specific improvements.
                    <span class="resume-ai-powered">Powered by GPT-4o mini</span>
                </p>
                <div id="analyzeError" class="match-error-banner mt-2 w-100" style="display:none"></div>
            </div>

            @if (Model.ScoreResult != null)
            {
                <div class="resume-score-result mt-3" id="resumeScoreResult">
                @if (Model.ScoreResult.Success)
                {
                    <div class="match-score-card">
                        <div class="match-score-left">
                            <div class="score-ring-wrap">
                                <svg class="score-svg" viewBox="0 0 140 140">
                                    <circle class="score-track" cx="70" cy="70" r="54" />
                                    <circle class="score-fill score-fill--@scoreColor"
                                            cx="70" cy="70" r="54"
                                            style="--ring-offset:@scoreDashOff;stroke-dasharray:@CircStr" />
                                </svg>
                                <div class="score-label">
                                    <span class="score-number">@Model.ScoreResult.Score</span>
                                    <span class="score-unit">%</span>
                                </div>
                            </div>
                        </div>
                        <div class="match-score-right">
                            <p class="match-score-title">Resume quality score</p>
                            <p class="match-summary">@Model.ScoreResult.Summary</p>
                        </div>
                    </div>

                    <div class="row g-3 mt-0">
                        @if (Model.ScoreResult.Strengths.Any())
                        {
                            <div class="col-md-6">
                                <div class="form-card form-card-inset">
                                    <p class="form-section-title section-title--strengths">Strengths</p>
                                    <ul class="match-strengths-list">
                                        @foreach (var s in Model.ScoreResult.Strengths)
                                        { <li>@s</li> }
                                    </ul>
                                </div>
                            </div>
                        }
                        @if (Model.ScoreResult.Improvements.Any())
                        {
                            <div class="col-md-6">
                                <div class="form-card form-card-inset">
                                    <p class="form-section-title section-title--improvements">Improvements</p>
                                    <ul class="match-strengths-list">
                                        @foreach (var imp in Model.ScoreResult.Improvements)
                                        { <li>@imp</li> }
                                    </ul>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="match-error-banner">@Model.ScoreResult.Error</div>
                }
                </div>
            }
        }
        else
        {
            <p class="form-hint mt-3 mb-0">Upload a resume and set it as active to unlock <strong>Analyze with AI</strong> and <strong>Score my resume</strong>.</p>
        }

        @* Paste-only, so it works with or without a resume on file. *@
        <partial name="_BulletRewriter" model="Model" />
    </div>
