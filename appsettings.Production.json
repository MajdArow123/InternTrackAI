{
  "AllowedHosts": "*",
  "RateLimiting": {
    "AI": {
      "PermitLimit": 20,
      "WindowMinutes": 60,
      "DemoPermitLimit": 10
    }
  },
  "Demo": {
    "AutoReset": false,
    "ResetTimeUtc": "04:00"
  },
  "Admin": {},
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  }
}
